<file path="src/hooks/use-chat-socket.ts">
import { useEffect, useRef } from 'react'
import { getSocket, disconnectSocket } from '@/lib/socket'
import { useChatStore } from '@/stores/chat.store'
import { useAuthStore } from '@/stores/auth.store'
import { chatApi } from '@/api/chat.api'
import type { ChatMessage, ChatRoom, TypingUser } from '@/types/chat.types'

export function useChatSocket() {
  const { isAuthenticated } = useAuthStore()
  const isSocketActive = useChatStore((s) => s.isSocketActive)
  const {
    setRooms,
    addMessageToRoom,
    updateLastMessage,
    incrementUnreadCount,
    setOnlineUserIds,
    addOnlineUser,
    removeOnlineUser,
    addTypingUser,
    removeTypingUser,
    openWindowRoomIds,
    updateRoom,
  } = useChatStore()
  const connectedRef = useRef(false)

  // Only connect when user opens chat (isSocketActive) AND is authenticated
  useEffect(() => {
    if (!isAuthenticated || !isSocketActive) {
      if (connectedRef.current) {
        disconnectSocket()
        connectedRef.current = false
      }
      return
    }

    const socket = getSocket()

    if (!connectedRef.current) {
      socket.connect()
      connectedRef.current = true
    }

    socket.on('connect', () => {
      chatApi.getRooms().then((res) => {
        setRooms(res.content)
      })
      socket.emit('get-online-users')
    })

    socket.on('rooms', (rooms: ChatRoom[]) => {
      setRooms(rooms)
    })

    socket.on('new-message', (message: ChatMessage) => {
      addMessageToRoom(message.roomId, message)
      updateLastMessage(message.roomId, message)

      const state = useChatStore.getState()
      if (!state.openWindowRoomIds.includes(message.roomId)) {
        incrementUnreadCount(message.roomId)
      } else {
        socket.emit('mark-as-read', { roomId: message.roomId })
      }
    })

    socket.on('room-updated', (room: ChatRoom) => {
      updateRoom(room)
    })

    socket.on('online-users', (userIds: number[]) => {
      setOnlineUserIds(userIds)
    })

    socket.on('user-online', (userId: number) => {
      addOnlineUser(userId)
    })

    socket.on('user-offline', (userId: number) => {
      removeOnlineUser(userId)
    })

    socket.on('user-typing', (data: TypingUser) => {
      addTypingUser(data)
      setTimeout(() => {
        removeTypingUser(data.userId, data.roomId)
      }, 3000)
    })

    socket.on('user-stop-typing', (data: { userId: number; roomId: number }) => {
      removeTypingUser(data.userId, data.roomId)
    })

    return () => {
      socket.off('connect')
      socket.off('rooms')
      socket.off('new-message')
      socket.off('room-updated')
      socket.off('online-users')
      socket.off('user-online')
      socket.off('user-offline')
      socket.off('user-typing')
      socket.off('user-stop-typing')
    }
  }, [isAuthenticated, isSocketActive])

  // Join rooms when windows open
  useEffect(() => {
    if (!isAuthenticated || !isSocketActive) return
    const socket = getSocket()
    openWindowRoomIds.forEach((roomId) => {
      socket.emit('join-room', { roomId })
    })
  }, [openWindowRoomIds, isAuthenticated, isSocketActive])
}
</file>

<file path="src/lib/auth-middleware.ts">
import { apiClient } from '@/api/client'
import { useAuthStore } from '@/stores'

let isRefreshing = false
let failedQueue: Array<{
  resolve: (value?: unknown) => void
  reject: (reason?: unknown) => void
}> = []

const processQueue = (error: unknown = null) => {
  failedQueue.forEach((prom) => {
    if (error) {
      prom.reject(error)
    } else {
      prom.resolve()
    }
  })
  failedQueue = []
}

export const setupAuthMiddleware = () => {
  // Response interceptor to handle 401 errors and refresh token
  apiClient.interceptors.response.use(
    (response) => response,
    async (error) => {
      const originalRequest = error.config

      // If error is 401 and we haven't tried to refresh yet
      if (error.response?.status === 401 && !originalRequest._retry) {
        if (isRefreshing) {
          // If already refreshing, queue this request
          return new Promise((resolve, reject) => {
            failedQueue.push({ resolve, reject })
          })
            .then(() => apiClient(originalRequest))
            .catch((err) => Promise.reject(err))
        }

        originalRequest._retry = true
        isRefreshing = true

        try {
          // Call refresh endpoint - cookies are sent automatically
          await apiClient.post('/api/auth/refresh')

          // Token refreshed successfully (new cookies are set by backend)
          isRefreshing = false
          processQueue(null)

          // Retry the original request
          return apiClient(originalRequest)
        } catch (refreshError) {
          // Refresh failed - logout user
          isRefreshing = false
          processQueue(refreshError)

          const { logout } = useAuthStore.getState()
          logout()

          // Redirect to login
          window.location.href = '/auth/login'

          return Promise.reject(refreshError)
        }
      }

      return Promise.reject(error)
    }
  )
}

// Validate session by calling /me endpoint
export const validateSession = async (): Promise<boolean> => {
  try {
    const response = await apiClient.get('/api/auth/me')

    // Update user data if it changed
    if (response.data?.content) {
      const { updateUser } = useAuthStore.getState()
      updateUser(response.data.content)
    }

    return true
  } catch {
    return false
  }
}
</file>

