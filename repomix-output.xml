<file path="src/pages/jobs/job-list.tsx">
import { useState } from 'react'
import { useQuery } from '@tanstack/react-query'
import { Link, useSearchParams } from 'react-router-dom'
import { Star, Search, X } from 'lucide-react'
import { Button, Card, CardContent, Spinner, Badge, Input, Pagination } from '@/components/ui'
import { jobsApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import type { Job } from '@/schemas'

const PAGE_SIZE = 8

export function JobListPage() {
  const [searchParams, setSearchParams] = useSearchParams()
  const typeId = searchParams.get('type') ? Number(searchParams.get('type')) : null
  const detailTypeId = searchParams.get('detailType') ? Number(searchParams.get('detailType')) : null
  const [page, setPage] = useState(Number(searchParams.get('page')) || 1)
  const [inputValue, setInputValue] = useState(searchParams.get('keyword') || '')
  const [searchKeyword, setSearchKeyword] = useState(searchParams.get('keyword') || '')

  // Normal paginated search (when no type filter)
  const { data: paginatedData, isLoading: paginatedLoading } = useQuery({
    queryKey: [...QUERY_KEYS.jobs, page, PAGE_SIZE, searchKeyword],
    queryFn: () => jobsApi.getPaginated({ page, pageSize: PAGE_SIZE, keyword: searchKeyword || undefined }),
    enabled: !typeId && !detailTypeId,
  })

  // Fetch detail types for a job type category (when type filter is active)
  const { data: detailTypesData, isLoading: detailTypesLoading } = useQuery({
    queryKey: [...QUERY_KEYS.jobDetailsByType(typeId!), typeId],
    queryFn: () => jobsApi.getDetailsByJobType(typeId!),
    enabled: !!typeId,
  })

  // Fetch jobs by detail type (when a specific detail type is selected)
  const { data: jobsByDetailData, isLoading: jobsByDetailLoading } = useQuery({
    queryKey: [...QUERY_KEYS.jobsByDetailType(detailTypeId!), detailTypeId],
    queryFn: () => jobsApi.getByDetailType(detailTypeId!),
    enabled: !!detailTypeId,
  })

  const isFiltered = !!typeId || !!detailTypeId
  const isLoading = paginatedLoading || detailTypesLoading || jobsByDetailLoading

  // Determine which jobs to show
  let jobs: Job[] = []
  let totalPages = 1
  let total = 0

  if (detailTypeId) {
    jobs = jobsByDetailData?.content || []
    total = jobs.length
    totalPages = 1
  } else if (typeId) {
    // When viewing a type but no detail type selected, show nothing yet — user picks a subcategory
    jobs = []
  } else {
    jobs = paginatedData?.content?.data || []
    totalPages = paginatedData?.content?.totalPages || 1
    total = paginatedData?.content?.total || 0
  }

  const detailTypes = detailTypesData?.content || []

  const handleSearch = () => {
    setSearchKeyword(inputValue)
    setPage(1)
    setSearchParams({ page: '1', keyword: inputValue })
  }

  const handlePageChange = (newPage: number) => {
    setPage(newPage)
    setSearchParams({ page: String(newPage), keyword: searchKeyword })
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const clearFilter = () => {
    setSearchParams({})
    setPage(1)
    setSearchKeyword('')
    setInputValue('')
  }

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-slate-950">
      <div className="container mx-auto px-4 py-8">
        <div className="mb-8">
          <h1 className="mb-4 text-3xl font-bold text-gray-900 dark:text-slate-50">Browse Jobs</h1>

          {!isFiltered && (
            <div className="flex gap-2">
              <Input
                placeholder="Search jobs..."
                value={inputValue}
                onChange={(e) => setInputValue(e.target.value)}
                onKeyDown={(e) => e.key === 'Enter' && handleSearch()}
                className="max-w-md"
              />
              <Button onClick={handleSearch}>
                <Search className="mr-2 h-4 w-4" />
                Search
              </Button>
            </div>
          )}

          {isFiltered && (
            <div className="flex items-center gap-2">
              <Badge variant="secondary" className="text-sm px-3 py-1">
                Filtered by category
              </Badge>
              <Button variant="ghost" size="sm" onClick={clearFilter}>
                <X className="mr-1 h-4 w-4" />
                Clear filter
              </Button>
            </div>
          )}
        </div>

        {/* Detail type sub-navigation when filtering by job type */}
        {typeId && detailTypes.length > 0 && (
          <Card className="mb-6">
            <CardContent className="p-4">
              <p className="mb-3 text-sm font-medium text-gray-500 dark:text-slate-400">Select a subcategory:</p>
              <div className="flex flex-wrap gap-2">
                {detailTypes.map((dt: any) => (
                  <Link
                    key={dt.id}
                    to={`/jobs?detailType=${dt.id}`}
                  >
                    <Badge
                      variant={detailTypeId === dt.id ? 'default' : 'secondary'}
                      className="cursor-pointer px-3 py-1.5 text-sm transition-colors hover:bg-zinc-200 dark:hover:bg-slate-700"
                    >
                      {dt.tenChiTiet}
                    </Badge>
                  </Link>
                ))}
              </div>
            </CardContent>
          </Card>
        )}

        {typeId && !detailTypeId && detailTypes.length > 0 && (
          <div className="py-12 text-center">
            <p className="text-gray-500 dark:text-slate-400">Select a subcategory above to view jobs</p>
          </div>
        )}

        {isLoading ? (
          <div className="flex justify-center py-12">
            <Spinner size="lg" />
          </div>
        ) : jobs.length === 0 && (!typeId || detailTypeId) ? (
          <div className="py-12 text-center">
            <p className="text-gray-500 dark:text-slate-400">No jobs found</p>
          </div>
        ) : jobs.length > 0 ? (
          <>
            {!isFiltered && (
              <div className="mb-4 text-sm text-gray-500 dark:text-slate-400">
                Showing {(page - 1) * PAGE_SIZE + 1}-{Math.min(page * PAGE_SIZE, total)} of {total} jobs
              </div>
            )}

            {isFiltered && (
              <div className="mb-4 text-sm text-gray-500 dark:text-slate-400">
                {total} job{total !== 1 ? 's' : ''} found
              </div>
            )}

            <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {jobs.map((job) => (
                <Link key={job.id} to={`/jobs/${job.id}`}>
                  <Card className="h-full cursor-pointer transition-all duration-200 hover:shadow-lg hover:-translate-y-1">
                    <CardContent className="p-4">
                      {job.hinhAnh && (
                        <img
                          src={job.hinhAnh}
                          alt={job.tenCongViec}
                          className="mb-4 h-40 w-full rounded-lg object-cover"
                        />
                      )}
                      <h3 className="mb-2 text-base font-semibold text-gray-900 dark:text-slate-50 line-clamp-2">
                        {job.tenCongViec}
                      </h3>
                      <p className="mb-4 text-sm text-gray-500 dark:text-slate-400 line-clamp-2">
                        {job.moTaNgan}
                      </p>
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-1">
                          <Star className="h-4 w-4 fill-yellow-400 text-yellow-400" />
                          <span className="text-sm font-medium text-gray-900 dark:text-slate-200">{job.saoCongViec || 0}</span>
                          <span className="text-sm text-gray-400 dark:text-slate-500">
                            ({job.danhGia || 0})
                          </span>
                        </div>
                        <Badge variant="secondary">${job.giaTien}</Badge>
                      </div>
                    </CardContent>
                  </Card>
                </Link>
              ))}
            </div>

            {/* Pagination - only for non-filtered results */}
            {!isFiltered && totalPages > 1 && (
              <div className="mt-8">
                <Pagination
                  currentPage={page}
                  totalPages={totalPages}
                  onPageChange={handlePageChange}
                />
              </div>
            )}
          </>
        ) : null}
      </div>
    </div>
  )
}
</file>

