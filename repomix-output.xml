import { Minus, X } from 'lucide-react'
import { ChatAvatar } from './chat-avatar'

interface ChatWindowHeaderProps {
  name: string
  avatar?: string
  isOnline: boolean
  isMinimized: boolean
  onMinimize: () => void
  onClose: () => void
  onRestore: () => void
}

export function ChatWindowHeader({
  name,
  avatar,
  isOnline,
  isMinimized,
  onMinimize,
  onClose,
  onRestore,
}: ChatWindowHeaderProps) {
  return (
    <div
      className="flex cursor-pointer items-center gap-2 border-b bg-white px-3 py-2 shadow-sm"
      onClick={isMinimized ? onRestore : undefined}
    >
      <ChatAvatar name={name} avatar={avatar} isOnline={isOnline} size="sm" />
      <div className="flex-1 truncate">
        <p className="truncate text-sm font-semibold">{name}</p>
        {isOnline && (
          <p className="text-[11px] text-green-600">Active now</p>
        )}
      </div>
      <div className="flex items-center gap-0.5">
        <button
          onClick={(e) => {
            e.stopPropagation()
            isMinimized ? onRestore() : onMinimize()
          }}
          className="rounded-full p-1 text-gray-500 hover:bg-gray-100"
        >
          <Minus size={16} />
        </button>
        <button
          onClick={(e) => {
            e.stopPropagation()
            onClose()
          }}
          className="rounded-full p-1 text-gray-500 hover:bg-gray-100"
        >
          <X size={16} />
        </button>
      </div>
    </div>
  )
}
