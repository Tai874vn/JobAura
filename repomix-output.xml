import { apiClient } from './client'
import type { ApiResponse } from '@/schemas'
import type { ChatRoom, ChatMessage } from '@/types/chat.types'

export const chatApi = {
  getRooms: async (): Promise<ApiResponse<ChatRoom[]>> => {
    const response = await apiClient.get('/api/chat/rooms')
    return response.data
  },

  getRoom: async (id: number): Promise<ApiResponse<ChatRoom>> => {
    const response = await apiClient.get(`/api/chat/rooms/${id}`)
    return response.data
  },

  getMessages: async (
    roomId: number,
    params?: { before?: number; limit?: number }
  ): Promise<ApiResponse<ChatMessage[]>> => {
    const response = await apiClient.get(`/api/chat/rooms/${roomId}/messages`, {
      params,
    })
    return response.data
  },

  startPrivateChat: async (userId: number): Promise<ApiResponse<ChatRoom>> => {
    const response = await apiClient.get(`/api/chat/start/${userId}`)
    return response.data
  },

  createRoom: async (data: {
    name?: string
    memberIds: number[]
  }): Promise<ApiResponse<ChatRoom>> => {
    const response = await apiClient.post('/api/chat/rooms', data)
    return response.data
  },

  leaveRoom: async (roomId: number): Promise<ApiResponse<void>> => {
    const response = await apiClient.post(`/api/chat/rooms/${roomId}/leave`)
    return response.data
  },
}
</file>

