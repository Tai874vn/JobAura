<file path="src/hooks/use-chat-messages.ts">
import { useCallback, useRef, useState } from 'react'
import { getSocket } from '@/lib/socket'
import { useChatStore } from '@/stores/chat.store'
import { useAuthStore } from '@/stores/auth.store'
import { chatApi } from '@/api/chat.api'

export function useChatMessages(roomId: number) {
  const { messages, setMessagesForRoom, prependMessagesToRoom, clearUnreadCount } =
    useChatStore()
  const { user } = useAuthStore()
  const [isLoadingOlder, setIsLoadingOlder] = useState(false)
  const [hasMore, setHasMore] = useState(true)
  const initialLoadDone = useRef(false)

  const roomMessages = messages[roomId] || []

  const loadInitialMessages = useCallback(async () => {
    if (initialLoadDone.current) return
    initialLoadDone.current = true
    try {
      const res = await chatApi.getMessages(roomId, { limit: 30 })
      setMessagesForRoom(roomId, res.content)
      setHasMore(res.content.length >= 30)

      // Mark as read
      const socket = getSocket()
      socket.emit('mark-as-read', { roomId })
      clearUnreadCount(roomId)
    } catch {
      initialLoadDone.current = false
    }
  }, [roomId, setMessagesForRoom, clearUnreadCount])

  const loadOlderMessages = useCallback(async () => {
    if (isLoadingOlder || !hasMore || roomMessages.length === 0) return
    setIsLoadingOlder(true)
    try {
      const oldestMessage = roomMessages[0]
      const res = await chatApi.getMessages(roomId, {
        before: oldestMessage.id,
        limit: 30,
      })
      if (res.content.length < 30) setHasMore(false)
      if (res.content.length > 0) {
        prependMessagesToRoom(roomId, res.content)
      }
    } finally {
      setIsLoadingOlder(false)
    }
  }, [roomId, isLoadingOlder, hasMore, roomMessages, prependMessagesToRoom])

  const sendMessage = useCallback(
    (content: string) => {
      if (!content.trim()) return
      const socket = getSocket()
      socket.emit('send-message', { roomId, content: content.trim() })
    },
    [roomId]
  )

  const emitTyping = useCallback(() => {
    const socket = getSocket()
    socket.emit('typing', { roomId })
  }, [roomId])

  const markAsRead = useCallback(() => {
    const socket = getSocket()
    socket.emit('mark-as-read', { roomId })
    clearUnreadCount(roomId)
  }, [roomId, clearUnreadCount])

  return {
    messages: roomMessages,
    isLoadingOlder,
    hasMore,
    loadInitialMessages,
    loadOlderMessages,
    sendMessage,
    emitTyping,
    markAsRead,
    currentUserId: user?.id,
  }
}
</file>

<file path="src/hooks/use-in-view.ts">
import { useEffect, useRef, useState } from 'react'

interface UseInViewOptions {
  threshold?: number
  rootMargin?: string
  triggerOnce?: boolean
}

export function useInView<T extends HTMLElement = HTMLDivElement>(
  options: UseInViewOptions = {}
) {
  const { threshold = 0.1, rootMargin = '0px', triggerOnce = true } = options
  const ref = useRef<T>(null)
  const [isInView, setIsInView] = useState(false)

  useEffect(() => {
    const element = ref.current
    if (!element) return

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setIsInView(true)
          if (triggerOnce) {
            observer.unobserve(element)
          }
        } else if (!triggerOnce) {
          setIsInView(false)
        }
      },
      { threshold, rootMargin }
    )

    observer.observe(element)

    return () => observer.disconnect()
  }, [threshold, rootMargin, triggerOnce])

  return { ref, isInView }
}
