import { useState } from 'react'
import { Link } from 'react-router-dom'
import { useMutation } from '@tanstack/react-query'
import { toast } from 'sonner'
import { Button, Input, Label, Card, CardContent, CardDescription, CardHeader, CardTitle, Spinner } from '@/components/ui'
import { authApi } from '@/api'
import { useAuthStore } from '@/stores'
import { signUpSchema } from '@/schemas'
import type { SignUp } from '@/schemas'
import { initiateGoogleLogin } from '@/lib/oauth'
import { getApiErrorMessage } from '@/lib/utils'

export function RegisterPage() {
  const { login } = useAuthStore()
  const [showOptional, setShowOptional] = useState(false)
  const [formData, setFormData] = useState<SignUp>({
    name: '',
    email: '',
    password: '',
  })
  const [errors, setErrors] = useState<Partial<Record<keyof SignUp, string>>>({})

  const registerMutation = useMutation({
    mutationFn: authApi.signUp,
    onSuccess: (data) => {
      login(data.content.user)
      toast.success('Account created successfully!')
      window.location.href = '/'
    },
    onError: (error) => {
      toast.error(getApiErrorMessage(error, 'Failed to create account'))
    },
  })

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()

    const result = signUpSchema.safeParse(formData)
    if (!result.success) {
      const fieldErrors: Partial<Record<keyof SignUp, string>> = {}
      result.error.issues.forEach((err) => {
        if (err.path[0]) {
          fieldErrors[err.path[0] as keyof SignUp] = err.message
        }
      })
      setErrors(fieldErrors)
      return
    }

    setErrors({})
    registerMutation.mutate(formData)
  }

  const handleChange = (field: keyof SignUp) => (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    setFormData({ ...formData, [field]: e.target.value })
    if (errors[field]) {
      setErrors({ ...errors, [field]: undefined })
    }
  }

  return (
    <div className="flex min-h-screen items-center justify-center bg-zinc-100 dark:bg-slate-950 px-4">
      <Card className="w-full max-w-md shadow-lg">
        <CardHeader className="text-center">
          <CardTitle className="text-2xl font-bold text-zinc-900 dark:text-slate-50">Create an account</CardTitle>
          <CardDescription>Get started with Fiverr today</CardDescription>
        </CardHeader>
        <CardContent>
          <form onSubmit={handleSubmit} className="space-y-4">
            <div className="space-y-2">
              <Label htmlFor="name">Full Name</Label>
              <Input
                id="name"
                type="text"
                placeholder="Enter your name"
                value={formData.name}
                onChange={handleChange('name')}
                disabled={registerMutation.isPending}
              />
              {errors.name && <p className="text-sm text-red-500">{errors.name}</p>}
            </div>

            <div className="space-y-2">
              <Label htmlFor="email">Email</Label>
              <Input
                id="email"
                type="email"
                placeholder="Enter your email"
                value={formData.email}
                onChange={handleChange('email')}
                disabled={registerMutation.isPending}
              />
              {errors.email && <p className="text-sm text-red-500">{errors.email}</p>}
            </div>

            <div className="space-y-2">
              <Label htmlFor="password">Password</Label>
              <Input
                id="password"
                type="password"
                placeholder="Create a password"
                value={formData.password}
                onChange={handleChange('password')}
                disabled={registerMutation.isPending}
              />
              {errors.password && <p className="text-sm text-red-500">{errors.password}</p>}
            </div>

            <button
              type="button"
              onClick={() => setShowOptional(!showOptional)}
              className="w-full text-sm text-zinc-500 dark:text-slate-400 hover:text-zinc-700 dark:hover:text-slate-300 transition-colors text-left"
            >
              {showOptional ? '- Hide' : '+ Show'} optional fields
            </button>

            {showOptional && (
              <div className="space-y-4 rounded-lg border border-zinc-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 p-4">
                <div className="space-y-2">
                  <Label htmlFor="phone">Phone</Label>
                  <Input
                    id="phone"
                    type="tel"
                    placeholder="Your phone number"
                    value={formData.phone || ''}
                    onChange={handleChange('phone')}
                    disabled={registerMutation.isPending}
                  />
                </div>

                <div className="space-y-2">
                  <Label htmlFor="birthDay">Birthday</Label>
                  <Input
                    id="birthDay"
                    type="date"
                    value={formData.birthDay || ''}
                    onChange={handleChange('birthDay')}
                    disabled={registerMutation.isPending}
                  />
                </div>

                <div className="space-y-2">
                  <Label htmlFor="gender">Gender</Label>
                  <select
                    id="gender"
                    value={formData.gender || ''}
                    onChange={handleChange('gender')}
                    disabled={registerMutation.isPending}
                    className="w-full rounded-md border border-zinc-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-900 dark:text-slate-50 px-3 py-2 text-sm"
                  >
                    <option value="">Prefer not to say</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                    <option value="other">Other</option>
                  </select>
                </div>

                <div className="space-y-2">
                  <Label htmlFor="skill">Skills</Label>
                  <Input
                    id="skill"
                    placeholder="e.g. Web Design, Marketing"
                    value={formData.skill || ''}
                    onChange={handleChange('skill')}
                    disabled={registerMutation.isPending}
                  />
                </div>

                <div className="space-y-2">
                  <Label htmlFor="certification">Certification</Label>
                  <Input
                    id="certification"
                    placeholder="Your certifications"
                    value={formData.certification || ''}
                    onChange={handleChange('certification')}
                    disabled={registerMutation.isPending}
                  />
                </div>
              </div>
            )}

            <div>
              <Button type="submit" className="w-full" disabled={registerMutation.isPending}>
                {registerMutation.isPending ? (
                  <>
                    <Spinner size="sm" className="mr-2" />
                    Creating account...
                  </>
                ) : (
                  'Create account'
                )}
              </Button>
            </div>

            <div className="relative my-6">
              <div className="absolute inset-0 flex items-center">
                <span className="w-full border-t border-zinc-200 dark:border-slate-700" />
              </div>
              <div className="relative flex justify-center text-xs uppercase">
                <span className="bg-white dark:bg-slate-800 px-2 text-zinc-500 dark:text-slate-400">Or continue with</span>
              </div>
            </div>

            <div>
              <Button
                type="button"
                variant="outline"
                className="w-full"
                onClick={initiateGoogleLogin}
              >
                <svg className="mr-2 h-4 w-4" viewBox="0 0 24 24">
                  <path
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                    fill="#4285F4"
                  />
                  <path
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                    fill="#34A853"
                  />
                  <path
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                    fill="#FBBC05"
                  />
                  <path
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                    fill="#EA4335"
                  />
                </svg>
                Continue with Google
              </Button>
            </div>
          </form>

          <div className="mt-6 text-center text-sm text-slate-600 dark:text-slate-400">
            Already have an account?{' '}
            <Link to="/auth/login" className="font-medium text-zinc-900 dark:text-slate-50 hover:underline">
              Sign in
            </Link>
          </div>
        </CardContent>
      </Card>
    </div>
  )
}
</file>

<file path="src/routes/index.tsx">
import { lazy, Suspense } from 'react'
import { createBrowserRouter, Navigate } from 'react-router-dom'
import { MainLayout } from '@/components/layout/main-layout'
import { AdminLayout } from '@/components/layout/admin-layout'
import { ProtectedRoute } from '@/components/auth/protected-route'
import { Spinner } from '@/components/ui'

// Lazy load pages
const HomePage = lazy(() => import('@/pages/jobs/home').then(m => ({ default: m.HomePage })))
const LoginPage = lazy(() => import('@/pages/auth/login').then(m => ({ default: m.LoginPage })))
const RegisterPage = lazy(() => import('@/pages/auth/register').then(m => ({ default: m.RegisterPage })))
const OAuthCallbackPage = lazy(() => import('@/pages/auth/oauth-callback').then(m => ({ default: m.OAuthCallbackPage })))
const JobListPage = lazy(() => import('@/pages/jobs/job-list').then(m => ({ default: m.JobListPage })))
const JobDetailPage = lazy(() => import('@/pages/jobs/job-detail').then(m => ({ default: m.JobDetailPage })))
const MyHiredJobsPage = lazy(() => import('@/pages/jobs/my-hired-jobs').then(m => ({ default: m.MyHiredJobsPage })))
const CreateJobPage = lazy(() => import('@/pages/jobs/create-job').then(m => ({ default: m.CreateJobPage })))
const MyPostsPage = lazy(() => import('@/pages/jobs/my-posts').then(m => ({ default: m.MyPostsPage })))
const PublicProfilePage = lazy(() => import('@/pages/users/public-profile').then(m => ({ default: m.PublicProfilePage })))
const SettingsPage = lazy(() => import('@/pages/settings/settings').then(m => ({ default: m.SettingsPage })))

// Admin pages
const AdminDashboard = lazy(() => import('@/pages/admin/dashboard').then(m => ({ default: m.AdminDashboard })))
const JobsAdminPage = lazy(() => import('@/pages/admin/jobs-admin').then(m => ({ default: m.JobsAdminPage })))
const UsersAdminPage = lazy(() => import('@/pages/admin/users-admin').then(m => ({ default: m.UsersAdminPage })))
const JobTypesAdminPage = lazy(() => import('@/pages/admin/job-types-admin').then(m => ({ default: m.JobTypesAdminPage })))
const HiredJobsAdminPage = lazy(() => import('@/pages/admin/hired-jobs-admin').then(m => ({ default: m.HiredJobsAdminPage })))
const CommentsAdminPage = lazy(() => import('@/pages/admin/comments-admin').then(m => ({ default: m.CommentsAdminPage })))
const JobDetailTypesAdminPage = lazy(() => import('@/pages/admin/job-detail-types-admin').then(m => ({ default: m.JobDetailTypesAdminPage })))

function PageLoader() {
  return (
    <div className="flex min-h-screen items-center justify-center">
      <Spinner size="lg" />
    </div>
  )
}

export const router = createBrowserRouter([
  // Public routes with main layout
  {
    path: '/',
    element: <MainLayout />,
    children: [
      {
        index: true,
        element: (
          <Suspense fallback={<PageLoader />}>
            <HomePage />
          </Suspense>
        ),
      },
      {
        path: 'auth/login',
        element: (
          <Suspense fallback={<PageLoader />}>
            <LoginPage />
          </Suspense>
        ),
      },
      {
        path: 'auth/register',
        element: (
          <Suspense fallback={<PageLoader />}>
            <RegisterPage />
          </Suspense>
        ),
      },
      {
        path: 'auth/callback',
        element: (
          <Suspense fallback={<PageLoader />}>
            <OAuthCallbackPage />
          </Suspense>
        ),
      },
      {
        path: 'jobs',
        element: (
          <Suspense fallback={<PageLoader />}>
            <JobListPage />
          </Suspense>
        ),
      },
      {
        path: 'jobs/new',
        element: (
          <ProtectedRoute>
            <Suspense fallback={<PageLoader />}>
              <CreateJobPage />
            </Suspense>
          </ProtectedRoute>
        ),
      },
      {
        path: 'jobs/:id',
        element: (
          <Suspense fallback={<PageLoader />}>
            <JobDetailPage />
          </Suspense>
        ),
      },
      {
        path: 'my-jobs',
        element: (
          <ProtectedRoute>
            <Suspense fallback={<PageLoader />}>
              <MyHiredJobsPage />
            </Suspense>
          </ProtectedRoute>
        ),
      },
      {
        path: 'profile/:id',
        element: (
          <Suspense fallback={<PageLoader />}>
            <PublicProfilePage />
          </Suspense>
        ),
      },
      {
        path: 'my-posts',
        element: (
          <ProtectedRoute>
            <Suspense fallback={<PageLoader />}>
              <MyPostsPage />
            </Suspense>
          </ProtectedRoute>
        ),
      },
      {
        path: 'settings',
        element: (
          <ProtectedRoute>
            <Suspense fallback={<PageLoader />}>
              <SettingsPage />
            </Suspense>
          </ProtectedRoute>
        ),
      },
    ],
  },
  // Admin routes with admin layout
  {
    path: '/admin',
    element: (
      <ProtectedRoute requireAdmin>
        <AdminLayout />
      </ProtectedRoute>
    ),
    children: [
      {
        index: true,
        element: (
          <Suspense fallback={<PageLoader />}>
            <AdminDashboard />
          </Suspense>
        ),
      },
      {
        path: 'jobs',
        element: (
          <Suspense fallback={<PageLoader />}>
            <JobsAdminPage />
          </Suspense>
        ),
      },
      {
        path: 'users',
        element: (
          <Suspense fallback={<PageLoader />}>
            <UsersAdminPage />
          </Suspense>
        ),
      },
      {
        path: 'job-types',
        element: (
          <Suspense fallback={<PageLoader />}>
            <JobTypesAdminPage />
          </Suspense>
        ),
      },
      {
        path: 'job-detail-types',
        element: (
          <Suspense fallback={<PageLoader />}>
            <JobDetailTypesAdminPage />
          </Suspense>
        ),
      },
      {
        path: 'hired-jobs',
        element: (
          <Suspense fallback={<PageLoader />}>
            <HiredJobsAdminPage />
          </Suspense>
        ),
      },
      {
        path: 'comments',
        element: (
          <Suspense fallback={<PageLoader />}>
            <CommentsAdminPage />
          </Suspense>
        ),
      },
    ],
  },
  // Catch all
  {
    path: '*',
    element: <Navigate to="/" replace />,
  },
])
</file>

<file path="src/components/layout/header.tsx">
import { Link, useNavigate } from 'react-router-dom'
import { LogOut, LayoutDashboard, ClipboardList, PlusCircle, FileText, Sun, Moon, User, Settings } from 'lucide-react'
import { Button, DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuItem, DropdownMenuSeparator } from '@/components/ui'
import { useAuthStore } from '@/stores'
import { useTheme } from '@/contexts/theme.context'

export function Header() {
  const { isAuthenticated, user, logout, _hasHydrated } = useAuthStore()
  const navigate = useNavigate()
  const { effectiveTheme, toggleTheme } = useTheme()

  // Wait for Zustand to hydrate from localStorage before showing auth state
  const showAuthenticatedUI = _hasHydrated && isAuthenticated

  const handleLogout = () => {
    logout()
    navigate('/auth/login')
  }

  return (
    <header className="sticky top-0 z-50 w-full border-b bg-white dark:bg-slate-900 border-gray-200 dark:border-slate-700 shadow-sm transition-colors duration-200">
      <div className="container mx-auto flex h-16 items-center justify-between px-4">
        <Link to="/" className="text-2xl font-bold text-primary dark:text-emerald-400">
          Fiverr
        </Link>

        <nav className="flex items-center gap-4">
          {/* Theme toggle button */}
          <button
            onClick={toggleTheme}
            className="rounded-lg p-2 text-gray-700 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors"
            aria-label="Toggle theme"
          >
            {effectiveTheme === 'light' ? (
              <Moon className="h-5 w-5" />
            ) : (
              <Sun className="h-5 w-5" />
            )}
          </button>

          {showAuthenticatedUI ? (
            <>
              {user?.role === 'admin' && (
                <Link to="/admin">
                  <Button variant="ghost" className="dark:text-slate-300 dark:hover:bg-slate-800">
                    <LayoutDashboard className="mr-2 h-4 w-4" />
                    Admin
                  </Button>
                </Link>
              )}
              <Link to="/jobs/new">
                <Button className="dark:bg-emerald-600 dark:hover:bg-emerald-700">
                  <PlusCircle className="mr-2 h-4 w-4" />
                  Post a Job
                </Button>
              </Link>
              <Link to="/my-posts">
                <Button variant="ghost" className="dark:text-slate-300 dark:hover:bg-slate-800">
                  <FileText className="mr-2 h-4 w-4" />
                  My Posts
                </Button>
              </Link>
              <Link to="/my-jobs">
                <Button variant="ghost" className="dark:text-slate-300 dark:hover:bg-slate-800">
                  <ClipboardList className="mr-2 h-4 w-4" />
                  My Jobs
                </Button>
              </Link>

              {/* Profile Dropdown */}
              <DropdownMenu>
                <DropdownMenuTrigger>
                  <div className="flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium text-zinc-700 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                    {user?.avatar ? (
                      <img
                        src={user.avatar}
                        alt={user.name}
                        referrerPolicy="no-referrer"
                        className="h-7 w-7 rounded-full object-cover" />
                    ) : (
                      <div className="flex h-7 w-7 items-center justify-center rounded-full bg-zinc-200 dark:bg-slate-700 text-xs font-semibold text-zinc-600 dark:text-slate-300">
                        {user?.name?.[0]?.toUpperCase()}
                      </div>
                    )}
                    <span className="hidden md:inline">{user?.name}</span>
                  </div>
                </DropdownMenuTrigger>
                <DropdownMenuContent align="right">
                  <DropdownMenuItem onClick={() => navigate(`/profile/${user?.id}`)}>
                    <User className="h-4 w-4" />
                    <span>Profile</span>
                  </DropdownMenuItem>
                  <DropdownMenuItem onClick={() => navigate('/settings')}>
                    <Settings className="h-4 w-4" />
                    <span>Settings</span>
                  </DropdownMenuItem>
                  <DropdownMenuSeparator />
                  <DropdownMenuItem onClick={handleLogout}>
                    <LogOut className="h-4 w-4" />
                    <span>Logout</span>
                  </DropdownMenuItem>
                </DropdownMenuContent>
              </DropdownMenu>
            </>
          ) : (
            <>
              <Link to="/auth/login">
                <Button variant="outline">Login</Button>
              </Link>
              <Link to="/auth/register">
                <Button>Sign Up</Button>
              </Link>
            </>
          )}
        </nav>
      </div>
    </header>
  )
}
