import { useState, useRef } from 'react'
import { useParams, useNavigate, Link } from 'react-router-dom'
import { useQuery, useMutation } from '@tanstack/react-query'
import {
  Star,
  User,
  Pencil,
  Trash2,
  Upload,
  ChevronRight,
  CheckCircle2,
  Shield,
  Clock,
  MessageSquare,
  Sparkles,
  ArrowLeft,
} from 'lucide-react'
import { toast } from 'sonner'
import { Button, Spinner, Textarea, Modal, Label, Input } from '@/components/ui'
import { jobsApi, hiredJobsApi, commentsApi, jobDetailTypesApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { useAuthStore } from '@/stores'
import { queryClient } from '@/lib/query-client'
import { getApiErrorMessage } from '@/lib/utils'
import type { CreateJob } from '@/schemas'

function formatDate(dateStr: string | undefined) {
  if (!dateStr) return ''
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  })
}

function StarRating({ value, size = 'sm' }: { value: number; size?: 'sm' | 'md' }) {
  const sizeClass = size === 'sm' ? 'h-3.5 w-3.5' : 'h-4 w-4'
  return (
    <div className="flex items-center gap-0.5">
      {[1, 2, 3, 4, 5].map((star) => (
        <Star
          key={star}
          className={`${sizeClass} ${
            star <= value ? 'fill-amber-400 text-amber-400' : 'text-zinc-200'
          }`}
        />
      ))}
    </div>
  )
}

export function JobDetailPage() {
  const { id } = useParams<{ id: string }>()
  const navigate = useNavigate()
  const { user, isAuthenticated } = useAuthStore()
  const [comment, setComment] = useState('')
  const [rating, setRating] = useState(5)
  const [hoveredStar, setHoveredStar] = useState(0)
  const [isEditModalOpen, setIsEditModalOpen] = useState(false)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [editPreviewUrl, setEditPreviewUrl] = useState<string | null>(null)
  const editFileInputRef = useRef<HTMLInputElement>(null)
  const [editFormData, setEditFormData] = useState<Partial<CreateJob>>({})

  const { data, isLoading } = useQuery({
    queryKey: QUERY_KEYS.jobDetails(Number(id)),
    queryFn: () => jobsApi.getDetails(Number(id)),
    enabled: !!id,
  })

  const hireMutation = useMutation({
    mutationFn: () => hiredJobsApi.create({ maCongViec: Number(id) }),
    onSuccess: () => toast.success('Job hired successfully!'),
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to hire this job')),
  })

  const commentMutation = useMutation({
    mutationFn: () =>
      commentsApi.create({
        maCongViec: Number(id),
        noiDung: comment,
        saoBinhLuan: rating,
      }),
    onSuccess: () => {
      toast.success('Review posted!')
      setComment('')
      setRating(5)
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobDetails(Number(id)) })
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to post review')),
  })

  const { data: jobDetailTypesData } = useQuery({
    queryKey: QUERY_KEYS.jobDetailTypes,
    queryFn: jobDetailTypesApi.getAll,
    enabled: isEditModalOpen,
  })

  const updateMutation = useMutation({
    mutationFn: async (formData: Partial<CreateJob>) => {
      const result = await jobsApi.update(Number(id), formData)
      if (selectedFile) await jobsApi.uploadImage(Number(id), selectedFile)
      return result
    },
    onSuccess: () => {
      toast.success('Job updated successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobDetails(Number(id)) })
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
      if (editPreviewUrl?.startsWith('blob:')) URL.revokeObjectURL(editPreviewUrl)
      setIsEditModalOpen(false)
      setSelectedFile(null)
      setEditPreviewUrl(null)
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to update job')),
  })

  const deleteMutation = useMutation({
    mutationFn: () => jobsApi.delete(Number(id)),
    onSuccess: () => {
      toast.success('Job deleted successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
      navigate('/my-posts')
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to delete job')),
  })

  const handleHire = () => {
    if (!isAuthenticated) {
      toast.error('Please login to hire this job')
      navigate('/auth/login')
      return
    }
    hireMutation.mutate()
  }

  const handleComment = () => {
    if (!isAuthenticated) {
      toast.error('Please login to comment')
      navigate('/auth/login')
      return
    }
    if (!comment.trim()) {
      toast.error('Please enter a comment')
      return
    }
    commentMutation.mutate()
  }

  if (isLoading) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-[#fafaf9] dark:bg-slate-950">
        <Spinner size="lg" />
      </div>
    )
  }

  const job = data?.content
  const isOwner = isAuthenticated && user?.id === job?.nguoiTao

  if (!job) {
    return (
      <div className="flex min-h-screen flex-col items-center justify-center gap-4 bg-[#fafaf9] dark:bg-slate-950">
        <div className="text-6xl font-light text-zinc-300 dark:text-slate-700">404</div>
        <p className="text-zinc-500 dark:text-slate-400">This service doesn't exist</p>
        <Button variant="outline" size="sm" onClick={() => navigate('/jobs')}>
          <ArrowLeft className="mr-2 h-4 w-4" />
          Browse jobs
        </Button>
      </div>
    )
  }

  const sellerInitials = job.nguoiDung?.name
    ?.split(' ')
    .map((w) => w[0])
    .join('')
    .toUpperCase()
    .slice(0, 2)
  const reviewCount = job.binhLuans?.length || 0

  return (
    <div className="min-h-screen bg-[#fafaf9] dark:bg-slate-950">
      {/* Breadcrumb */}
      <div className="border-b border-zinc-100 dark:border-slate-800 bg-white dark:bg-slate-900">
        <div className="container mx-auto flex items-center gap-2 px-4 py-3 text-sm md:px-8">
          <Link to="/jobs" className="text-zinc-400 dark:text-slate-500 transition-colors hover:text-zinc-700 dark:hover:text-slate-300">Jobs</Link>
          {job.chiTietLoaiCongViec?.loaiCongViec && (
            <>
              <ChevronRight className="h-3.5 w-3.5 text-zinc-300 dark:text-slate-600" />
              <span className="text-zinc-400 dark:text-slate-500">{job.chiTietLoaiCongViec.loaiCongViec.tenLoaiCongViec}</span>
            </>
          )}
          {job.chiTietLoaiCongViec && (
            <>
              <ChevronRight className="h-3.5 w-3.5 text-zinc-300 dark:text-slate-600" />
              <span className="font-medium text-zinc-700 dark:text-slate-300">{job.chiTietLoaiCongViec.tenChiTiet}</span>
            </>
          )}
        </div>
      </div>

      <div className="container mx-auto px-4 py-8 md:px-8">
        <div className="grid grid-cols-1 gap-8 lg:grid-cols-12">
          {/* ── Left column ── */}
          <div className="lg:col-span-8 space-y-6">
            {/* Title + meta */}
            <div className="animate-fade-in-up">
              <h1 className="text-2xl font-bold tracking-tight text-zinc-900 dark:text-slate-50 md:text-3xl">
                {job.tenCongViec}
              </h1>

              <div className="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                {/* Seller inline */}
                {job.nguoiDung && (
                  <Link
                    to={`/profile/${job.nguoiDung.id}`}
                    className="group flex items-center gap-2"
                  >
                    {job.nguoiDung.avatar ? (
                      <img src={job.nguoiDung.avatar} alt={job.nguoiDung.name} className="h-6 w-6 rounded-full object-cover" />
                    ) : (
                      <div className="flex h-6 w-6 items-center justify-center rounded-full bg-zinc-200 dark:bg-slate-700 text-[10px] font-bold text-zinc-600 dark:text-slate-300">
