import { useEffect, useRef } from 'react'
import { X, MessageCircle } from 'lucide-react'
import { useChatStore } from '@/stores/chat.store'
import { useAuthStore } from '@/stores/auth.store'
import { ChatPanelRoomItem } from './chat-panel-room-item'

export function ChatPanel() {
  const { user } = useAuthStore()
  const rooms = useChatStore((s) => s.rooms)
  const onlineUserIds = useChatStore((s) => s.onlineUserIds)
  const { closePanel, openWindow } = useChatStore()
  const panelRef = useRef<HTMLDivElement>(null)

  // Close panel on click outside
  useEffect(() => {
    const handleClickOutside = (e: MouseEvent) => {
      if (
        panelRef.current &&
        !panelRef.current.contains(e.target as Node) &&
        !(e.target as HTMLElement).closest('[data-chat-trigger]')
      ) {
        closePanel()
      }
    }
    document.addEventListener('mousedown', handleClickOutside)
    return () => document.removeEventListener('mousedown', handleClickOutside)
  }, [closePanel])

  const handleRoomClick = (roomId: number) => {
    openWindow(roomId)
  }

  return (
    <div
      ref={panelRef}
      className="fixed right-6 bottom-20 z-50 flex h-[480px] w-[360px] flex-col overflow-hidden rounded-lg bg-white shadow-xl"
    >
      {/* Header */}
      <div className="flex items-center justify-between border-b px-4 py-3">
        <h2 className="text-xl font-bold">Chats</h2>
        <button
          onClick={closePanel}
          className="rounded-full p-1 text-gray-500 hover:bg-gray-100"
        >
          <X size={20} />
        </button>
      </div>

      {/* Room list */}
      <div className="flex-1 overflow-y-auto px-1 py-1">
        {rooms.length === 0 ? (
          <div className="flex flex-col items-center justify-center gap-2 py-16 text-gray-400">
            <MessageCircle size={40} />
            <p className="text-sm">No conversations yet</p>
          </div>
        ) : (
          rooms.map((room) => {
            const otherMember = room.members.find((m) => m.id !== user?.id)
            const isOnline = otherMember
              ? onlineUserIds.has(otherMember.id)
              : false

            return (
              <ChatPanelRoomItem
                key={room.id}
                room={room}
                currentUserId={user?.id}
                isOnline={isOnline}
                onClick={() => handleRoomClick(room.id)}
              />
            )
          })
        )}
      </div>
    </div>
  )
}
</file>

