import { useState, useRef } from 'react'
import { useQuery, useMutation } from '@tanstack/react-query'
import { Pencil, Trash2, Plus, Upload, ImageIcon } from 'lucide-react'
import { toast } from 'sonner'
import { Button, Card, CardContent, Input, Badge, Spinner, Pagination, Modal, Label } from '@/components/ui'
import { jobDetailTypesApi, jobTypesApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { queryClient } from '@/lib/query-client'
import { getApiErrorMessage } from '@/lib/utils'
import type { JobDetailType, CreateJobDetailType } from '@/schemas'

export function JobDetailTypesAdminPage() {
  const [searchKeyword, setSearchKeyword] = useState('')
  const [page, setPage] = useState(1)
  const [isModalOpen, setIsModalOpen] = useState(false)
  const [editingItem, setEditingItem] = useState<JobDetailType | null>(null)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [previewUrl, setPreviewUrl] = useState<string | null>(null)
  const fileInputRef = useRef<HTMLInputElement>(null)
  const [formData, setFormData] = useState<CreateJobDetailType>({
    tenChiTiet: '',
    maLoaiCongViec: 0,
  })
  const pageSize = 10

  const { data, isLoading } = useQuery({
    queryKey: [...QUERY_KEYS.jobDetailTypes, page, pageSize, searchKeyword],
    queryFn: () => jobDetailTypesApi.getPaginated({ page, pageSize, keyword: searchKeyword || undefined }),
  })

  const { data: jobTypesData } = useQuery({
    queryKey: QUERY_KEYS.jobTypes,
    queryFn: jobTypesApi.getAll,
  })

  const createMutation = useMutation({
    mutationFn: async (data: CreateJobDetailType) => {
      const result = await jobDetailTypesApi.create(data)
      if (selectedFile && result.content?.id) {
        await jobDetailTypesApi.uploadGroupImage(result.content.id, selectedFile)
      }
      return result
    },
    onSuccess: () => {
      toast.success('Subcategory created successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobDetailTypes })
      closeModal()
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to create subcategory')),
  })

  const updateMutation = useMutation({
    mutationFn: async ({ id, data }: { id: number; data: Partial<CreateJobDetailType> }) => {
      const result = await jobDetailTypesApi.update(id, data)
      if (selectedFile) {
        await jobDetailTypesApi.uploadGroupImage(id, selectedFile)
      }
      return result
    },
    onSuccess: () => {
      toast.success('Subcategory updated successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobDetailTypes })
      closeModal()
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to update subcategory')),
  })

  const deleteMutation = useMutation({
    mutationFn: jobDetailTypesApi.delete,
    onSuccess: () => {
      toast.success('Subcategory deleted successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobDetailTypes })
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to delete subcategory')),
  })

  const handleDelete = (id: number, name: string) => {
    if (confirm(`Are you sure you want to delete "${name}"?`)) {
      deleteMutation.mutate(id)
    }
  }

  const handleSearch = (e: React.ChangeEvent<HTMLInputElement>) => {
    setSearchKeyword(e.target.value)
    setPage(1)
  }

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return
    setSelectedFile(file)
    setPreviewUrl(URL.createObjectURL(file))
  }

  const openCreateModal = () => {
    setEditingItem(null)
    setSelectedFile(null)
    setPreviewUrl(null)
    setFormData({
      tenChiTiet: '',
      maLoaiCongViec: jobTypesData?.content?.[0]?.id || 0,
    })
    setIsModalOpen(true)
  }

  const openEditModal = (item: JobDetailType) => {
    setEditingItem(item)
    setSelectedFile(null)
    setPreviewUrl(item.hinhAnh || null)
    setFormData({
      tenChiTiet: item.tenChiTiet,
      maLoaiCongViec: item.maLoaiCongViec,
    })
    setIsModalOpen(true)
  }

  const closeModal = () => {
    setIsModalOpen(false)
    setEditingItem(null)
    setSelectedFile(null)
    setPreviewUrl(null)
  }

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()
    if (!formData.tenChiTiet || !formData.maLoaiCongViec) {
      toast.error('Please fill in required fields')
      return
    }
    if (editingItem) {
      updateMutation.mutate({ id: editingItem.id, data: formData })
    } else {
      createMutation.mutate(formData)
    }
  }

  const items = data?.content?.data || []
  const totalPages = data?.content?.totalPages || 1
  const jobTypes = jobTypesData?.content || []
  const isSaving = createMutation.isPending || updateMutation.isPending

  return (
    <div className="p-8">
      <div className="mb-6 flex items-center justify-between">
        <h1 className="text-3xl font-bold">Manage Subcategories</h1>
        <Button onClick={openCreateModal}>
          <Plus className="mr-2 h-4 w-4" />
          Add Subcategory
        </Button>
      </div>

      <Card className="mb-6">
        <CardContent className="p-4">
          <Input placeholder="Search subcategories..." value={searchKeyword} onChange={handleSearch} />
        </CardContent>
      </Card>

      {isLoading ? (
        <div className="flex justify-center py-12"><Spinner size="lg" /></div>
      ) : items.length === 0 ? (
        <Card>
          <CardContent className="flex flex-col items-center justify-center py-12">
            <p className="text-gray-500">No subcategories found</p>
          </CardContent>
        </Card>
      ) : (
        <>
          <div className="space-y-4">
            {items.map((item) => (
              <Card key={item.id}>
                <CardContent className="flex items-center justify-between p-6">
                  <div className="flex items-center gap-4">
                    {item.hinhAnh ? (
                      <img src={item.hinhAnh} alt={item.tenChiTiet} className="h-12 w-12 rounded-lg object-cover" />
                    ) : (
                      <div className="flex h-12 w-12 items-center justify-center rounded-lg bg-gray-100">
                        <ImageIcon className="h-5 w-5 text-gray-400" />
                      </div>
                    )}
                    <div>
                      <h3 className="text-lg font-semibold">{item.tenChiTiet}</h3>
                      <Badge variant="secondary" className="mt-1">
                        {item.loaiCongViec?.tenLoaiCongViec || `Type ID: ${item.maLoaiCongViec}`}
                      </Badge>
                    </div>
                  </div>
                  <div className="flex gap-2">
                    <Button variant="outline" size="sm" onClick={() => openEditModal(item)}>
                      <Pencil className="h-4 w-4" />
                    </Button>
                    <Button
                      variant="destructive"
                      size="sm"
                      onClick={() => handleDelete(item.id, item.tenChiTiet)}
                      disabled={deleteMutation.isPending}
                    >
                      <Trash2 className="h-4 w-4" />
                    </Button>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
          <div className="mt-6">
            <Pagination currentPage={page} totalPages={totalPages} onPageChange={setPage} />
          </div>
        </>
      )}

      {/* Create/Edit Modal */}
      <Modal isOpen={isModalOpen} onClose={closeModal} title={editingItem ? 'Edit Subcategory' : 'Create New Subcategory'}>
        <form onSubmit={handleSubmit} className="space-y-4">
          {/* Image Upload */}
          <div>
            <Label>Image</Label>
            <input
              ref={fileInputRef}
              type="file"
              accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
              onChange={handleFileChange}
              className="hidden"
            />
            <div
              onClick={() => fileInputRef.current?.click()}
              className="mt-1 flex cursor-pointer items-center justify-center rounded-lg border-2 border-dashed border-gray-300 p-4 transition-colors hover:border-gray-400"
            >
              {previewUrl ? (
                <img src={previewUrl} alt="Preview" className="h-32 w-full rounded-md object-cover" />
              ) : (
                <div className="flex flex-col items-center gap-2 text-gray-400">
                  <Upload className="h-8 w-8" />
                  <span className="text-sm">Click to upload image</span>
                </div>
              )}
            </div>
          </div>

          <div>
            <Label htmlFor="tenChiTiet">Subcategory Name *</Label>
            <Input
              id="tenChiTiet"
              value={formData.tenChiTiet}
              onChange={(e) => setFormData({ ...formData, tenChiTiet: e.target.value })}
              placeholder="Enter subcategory name"
            />
          </div>

          <div>
            <Label htmlFor="maLoaiCongViec">Parent Category *</Label>
            <select
              id="maLoaiCongViec"
              value={formData.maLoaiCongViec}
              onChange={(e) => setFormData({ ...formData, maLoaiCongViec: Number(e.target.value) })}
              className="w-full rounded-md border border-gray-300 px-3 py-2"
            >
              <option value={0}>Select category</option>
              {jobTypes.map((type) => (
                <option key={type.id} value={type.id}>{type.tenLoaiCongViec}</option>
              ))}
            </select>
          </div>

          <div className="flex justify-end gap-2 pt-4">
            <Button type="button" variant="outline" onClick={closeModal}>Cancel</Button>
            <Button type="submit" disabled={isSaving}>
              {isSaving && <Spinner size="sm" className="mr-2" />}
              {editingItem ? 'Update' : 'Create'}
            </Button>
          </div>
        </form>
      </Modal>
    </div>
  )
}
</file>

