import { z } from 'zod'

// Auth Schemas
export const signUpSchema = z.object({
  name: z.string().min(2, 'Name must be at least 2 characters'),
  email: z.string().email('Invalid email address'),
  password: z.string().min(6, 'Password must be at least 6 characters'),
  phone: z.string().optional(),
  birthDay: z.string().optional(),
  gender: z.string().optional(),
  role: z.string().optional(),
  skill: z.string().optional(),
  certification: z.string().optional(),
})

export const signInSchema = z.object({
  email: z.string().email('Invalid email address'),
  password: z.string().min(1, 'Password is required'),
})

// User Schemas
export const userSchema = z.object({
  id: z.number(),
  name: z.string(),
  email: z.string().email(),
  passWord: z.string().optional(),
  phone: z.string().optional(),
  birthDay: z.string().optional(),
  avatar: z.string().optional(),
  gender: z.string().optional(),
  role: z.string().optional(),
  skill: z.string().optional(),
  certification: z.string().optional(),
  googleId: z.string().optional(),
  createdAt: z.string().optional(),
  updatedAt: z.string().optional(),
})

export const createUserSchema = z.object({
  name: z.string().min(2, 'Name must be at least 2 characters'),
  email: z.string().email('Invalid email address'),
  password: z.string().min(6, 'Password must be at least 6 characters'),
  phone: z.string().optional(),
  birthDay: z.string().optional(),
  gender: z.string().optional(),
  role: z.string().optional(),
  skill: z.string().optional(),
  certification: z.string().optional(),
})

export const updateUserSchema = z.object({
  name: z.string().min(2, 'Name must be at least 2 characters').optional(),
  email: z.string().email('Invalid email address').optional(),
  phone: z.string().optional(),
  birthDay: z.string().optional(),
  gender: z.string().optional(),
  role: z.string().optional(),
  skill: z.string().optional(),
  certification: z.string().optional(),
})

// Job Type Schemas
export const jobTypeSchema = z.object({
  id: z.number(),
  tenLoaiCongViec: z.string(),
})

export const createJobTypeSchema = z.object({
  tenLoaiCongViec: z.string().min(1, 'Job type name is required'),
})

export const updateJobTypeSchema = createJobTypeSchema.partial()

// Job Detail Type Schemas
export const jobDetailTypeSchema = z.object({
  id: z.number(),
  tenChiTiet: z.string(),
  hinhAnh: z.string().optional(),
  maLoaiCongViec: z.number(),
  loaiCongViec: jobTypeSchema.optional(),
})

export const createJobDetailTypeSchema = z.object({
  tenChiTiet: z.string().min(1, 'Detail name is required'),
  maLoaiCongViec: z.number(),
  hinhAnh: z.string().optional(),
})

export const updateJobDetailTypeSchema = createJobDetailTypeSchema.partial()

export const createJobDetailGroupSchema = z.object({
  tenNhom: z.string().min(1, 'Group name is required'),
  maLoaiCongViec: z.number(),
  hinhAnh: z.string().optional(),
})

// Job Schemas
export const jobSchema = z.object({
  id: z.number(),
  tenCongViec: z.string(),
  giaTien: z.number(),
  moTaNgan: z.string().optional(),
  moTa: z.string().optional(),
  maChiTietLoai: z.number(),
  nguoiTao: z.number().optional(),
  hinhAnh: z.string().optional(),
  danhGia: z.number(),
  saoCongViec: z.number(),
  createdAt: z.string().optional(),
  updatedAt: z.string().optional(),
  chiTietLoaiCongViec: jobDetailTypeSchema.optional(),
  nguoiDung: userSchema.pick({
    id: true,
    name: true,
    avatar: true,
  }).optional(),
})

export const createJobSchema = z.object({
  tenCongViec: z.string().min(1, 'Job name is required'),
  giaTien: z.number().min(0, 'Price must be positive'),
  moTaNgan: z.string().optional(),
  moTa: z.string().optional(),
  maChiTietLoai: z.number(),
  danhGia: z.number().default(0),
  saoCongViec: z.number().min(0).max(5).default(0),
  hinhAnh: z.string().optional(),
})

export const updateJobSchema = z.object({
  tenCongViec: z.string().min(1, 'Job name is required').optional(),
  giaTien: z.number().min(0, 'Price must be positive').optional(),
  moTaNgan: z.string().optional(),
  moTa: z.string().optional(),
  maChiTietLoai: z.number().optional(),
  danhGia: z.number().optional(),
  saoCongViec: z.number().min(0).max(5).optional(),
  hinhAnh: z.string().optional(),
})

// Comment Schemas
export const commentSchema = z.object({
  id: z.number(),
  maCongViec: z.number(),
  maNguoiBinhLuan: z.number(),
  ngayBinhLuan: z.string().optional(),
  noiDung: z.string(),
  saoBinhLuan: z.number(),
  nguoiDung: userSchema.pick({
    id: true,
    name: true,
    avatar: true,
  }).optional(),
})

export const createCommentSchema = z.object({
  maCongViec: z.number(),
  noiDung: z.string().min(1, 'Comment is required'),
  saoBinhLuan: z.number().min(1).max(5),
})

export const updateCommentSchema = z.object({
  maCongViec: z.number().optional(),
  maNguoiBinhLuan: z.number().optional(),
  noiDung: z.string().min(1, 'Comment is required').optional(),
  saoBinhLuan: z.number().min(1).max(5).optional(),
})

// Hired Job Schemas
export const hiredJobSchema = z.object({
  id: z.number(),
  maCongViec: z.number(),
  maNguoiThue: z.number(),
  ngayThue: z.string().optional(),
  hoanThanh: z.boolean(),
  congViec: jobSchema.optional(),
  nguoiDung: userSchema.pick({
    id: true,
    name: true,
    email: true,
    avatar: true,
  }).optional(),
})

export const createHiredJobSchema = z.object({
  maCongViec: z.number(),
})

export const updateHiredJobSchema = z.object({
  hoanThanh: z.boolean().optional(),
})

// Pagination Schema
export const paginationParamsSchema = z.object({
  page: z.number().min(1).default(1),
  pageSize: z.number().min(1).max(100).default(10),
  keyword: z.string().optional(),
})

// Response Schemas
export const apiResponseSchema = z.object({
  message: z.string(),
  content: z.any(),
})

export const paginatedResponseSchema = z.object({
  message: z.string(),
  content: z.object({
    data: z.array(z.any()),
    total: z.number(),
    page: z.number(),
    pageSize: z.number(),
    totalPages: z.number(),
  }),
})

// Type exports
export type SignUp = z.infer<typeof signUpSchema>
export type SignIn = z.infer<typeof signInSchema>
export type User = z.infer<typeof userSchema>
export type CreateUser = z.infer<typeof createUserSchema>
export type UpdateUser = z.infer<typeof updateUserSchema>
export type JobType = z.infer<typeof jobTypeSchema>
export type CreateJobType = z.infer<typeof createJobTypeSchema>
export type UpdateJobType = z.infer<typeof updateJobTypeSchema>
export type JobDetailType = z.infer<typeof jobDetailTypeSchema>
export type CreateJobDetailType = z.infer<typeof createJobDetailTypeSchema>
export type UpdateJobDetailType = z.infer<typeof updateJobDetailTypeSchema>
export type CreateJobDetailGroup = z.infer<typeof createJobDetailGroupSchema>
export type Job = z.infer<typeof jobSchema>
export type CreateJob = z.infer<typeof createJobSchema>
export type UpdateJob = z.infer<typeof updateJobSchema>
export type Comment = z.infer<typeof commentSchema>
export type CreateComment = z.infer<typeof createCommentSchema>
export type UpdateComment = z.infer<typeof updateCommentSchema>
export type HiredJob = z.infer<typeof hiredJobSchema>
export type CreateHiredJob = z.infer<typeof createHiredJobSchema>
export type UpdateHiredJob = z.infer<typeof updateHiredJobSchema>
export type PaginationParams = z.infer<typeof paginationParamsSchema>
export type ApiResponse<T = any> = {
  message: string
  content: T
}
export type PaginatedResponse<T = any> = {
  message: string
  content: {
    data: T[]
    total: number
    page: number
    pageSize: number
    totalPages: number
  }
}
</file>

