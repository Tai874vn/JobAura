import { useParams, Link } from 'react-router-dom'
import { useQuery } from '@tanstack/react-query'
import { Star, Briefcase, MessageSquare, Award, Calendar } from 'lucide-react'
import { Card, CardContent, Spinner, Badge } from '@/components/ui'
import { usersApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'

export function PublicProfilePage() {
  const { id } = useParams<{ id: string }>()

  const { data, isLoading } = useQuery({
    queryKey: QUERY_KEYS.publicProfile(Number(id)),
    queryFn: () => usersApi.getPublicProfile(Number(id)),
    enabled: !!id,
  })

  if (isLoading) {
    return (
      <div className="flex min-h-screen items-center justify-center">
        <Spinner size="lg" />
      </div>
    )
  }

  const profile = data?.content

  if (!profile) {
    return (
      <div className="container mx-auto px-4 py-16 text-center">
        <h2 className="text-2xl font-bold">User not found</h2>
      </div>
    )
  }

  const initials = profile.name
    .split(' ')
    .map((w) => w[0])
    .join('')
    .toUpperCase()
    .slice(0, 2)

  const skills = profile.skill
    ? profile.skill.split(',').map((s) => s.trim()).filter(Boolean)
    : []

  const certifications = profile.certification
    ? profile.certification.split(',').map((s) => s.trim()).filter(Boolean)
    : []

  return (
    <div className="min-h-screen bg-gray-50">
      <div className="container mx-auto px-4 py-8">
        <div className="grid grid-cols-1 gap-8 lg:grid-cols-3">
          {/* Profile sidebar */}
          <div>
            <Card className="sticky top-20">
              <CardContent className="p-6">
                <div className="flex flex-col items-center text-center">
                  {profile.avatar ? (
                    <img
                      src={profile.avatar}
                      alt={profile.name}
                      className="h-24 w-24 rounded-full object-cover"
                    />
                  ) : (
                    <div className="flex h-24 w-24 items-center justify-center rounded-full bg-gray-300 text-2xl font-bold text-gray-700">
                      {initials}
                    </div>
                  )}
                  <h1 className="mt-4 text-2xl font-bold">{profile.name}</h1>

                  {profile.createdAt && (
                    <p className="mt-1 flex items-center gap-1 text-sm text-gray-500">
                      <Calendar className="h-3.5 w-3.5" />
                      Member since {new Date(profile.createdAt).toLocaleDateString(undefined, { month: 'long', year: 'numeric' })}
                    </p>
                  )}
                </div>

                <div className="mt-6 flex justify-center gap-6">
                  <div className="text-center">
                    <div className="flex items-center justify-center gap-1 text-xl font-bold">
                      <Briefcase className="h-5 w-5 text-gray-500" />
                      {profile._count.congViecs}
                    </div>
                    <p className="text-xs text-gray-500">Services</p>
                  </div>
                  <div className="text-center">
                    <div className="flex items-center justify-center gap-1 text-xl font-bold">
                      <MessageSquare className="h-5 w-5 text-gray-500" />
                      {profile._count.binhLuans}
                    </div>
                    <p className="text-xs text-gray-500">Reviews</p>
                  </div>
                </div>

                {skills.length > 0 && (
                  <div className="mt-6 border-t pt-4">
                    <h3 className="mb-2 text-sm font-semibold text-gray-700">Skills</h3>
                    <div className="flex flex-wrap gap-1.5">
                      {skills.map((skill) => (
                        <Badge key={skill} variant="secondary">{skill}</Badge>
                      ))}
                    </div>
                  </div>
                )}

                {certifications.length > 0 && (
                  <div className="mt-4 border-t pt-4">
                    <h3 className="mb-2 text-sm font-semibold text-gray-700">Certifications</h3>
                    <div className="space-y-1.5">
                      {certifications.map((cert) => (
                        <div key={cert} className="flex items-center gap-1.5 text-sm text-gray-600">
                          <Award className="h-3.5 w-3.5 shrink-0 text-blue-500" />
                          {cert}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>
          </div>

          {/* Services */}
          <div className="lg:col-span-2">
            <h2 className="mb-4 text-xl font-bold">
              Services ({profile.congViecs.length})
            </h2>

            {profile.congViecs.length === 0 ? (
              <Card>
                <CardContent className="py-12 text-center text-gray-400">
                  No services posted yet.
                </CardContent>
              </Card>
            ) : (
              <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {profile.congViecs.map((job) => (
                  <Link key={job.id} to={`/jobs/${job.id}`}>
                    <Card className="h-full transition-shadow hover:shadow-md">
                      <CardContent className="p-0">
                        {job.hinhAnh && (
                          <img
                            src={job.hinhAnh}
                            alt={job.tenCongViec}
                            className="h-40 w-full rounded-t-lg object-cover"
                          />
                        )}
                        <div className="p-4">
                          <h3 className="mb-1 line-clamp-2 font-semibold">
                            {job.tenCongViec}
                          </h3>
                          {job.moTaNgan && (
                            <p className="mb-2 line-clamp-2 text-sm text-gray-500">
                              {job.moTaNgan}
                            </p>
                          )}
                          <div className="flex items-center justify-between">
                            <div className="flex items-center gap-1 text-sm">
                              <Star className="h-4 w-4 fill-yellow-400 text-yellow-400" />
                              <span className="font-medium">{job.saoCongViec || 0}</span>
                              <span className="text-gray-400">({job.danhGia || 0})</span>
                            </div>
                            <span className="font-bold">${job.giaTien}</span>
                          </div>
                        </div>
                      </CardContent>
                    </Card>
                  </Link>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
