let socket: Socket | null = null

export function getSocket(): Socket {
  if (!socket) {
    socket = io(`${API_BASE_URL}/chat`, {
      withCredentials: true,
      autoConnect: false,
      transports: ['websocket', 'polling'],
    })
  }
  return socket
}

