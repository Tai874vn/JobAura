import { useEffect } from 'react'
import { useSearchParams } from 'react-router-dom'
import { toast } from 'sonner'
import { Spinner } from '@/components/ui'
import { useAuthStore } from '@/stores'
import { handleOAuthCallback } from '@/lib/oauth'
import { authApi } from '@/api'

export function OAuthCallbackPage() {
  const [searchParams] = useSearchParams()
  const { login } = useAuthStore()

  useEffect(() => {
    const processCallback = async () => {
      const result = handleOAuthCallback(searchParams)

      if (!result.success) {
        toast.error(result.error || 'OAuth login failed')
        window.location.href = '/auth/login'
        return
      }

      try {
        // Backend has set cookie, now fetch user data
        // The cookie will be sent automatically due to withCredentials: true
        const userResponse = await authApi.getCurrentUser()

        // Login with user data (token is in httpOnly cookies)
        login(userResponse.content)
        toast.success('Successfully logged in with Google!')

        // Use window.location for full page reload to ensure Zustand state
        // is properly rehydrated from localStorage on the destination page
        window.location.href = '/'
      } catch (error: any) {
        console.error('OAuth callback error:', error)
        toast.error(error?.response?.data?.message || 'Failed to complete Google login')
        window.location.href = '/auth/login'
      }
    }

    processCallback()
  }, [searchParams, login])

  return (
    <div className="flex min-h-screen items-center justify-center bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50">
      <div className="text-center">
        <Spinner size="lg" className="mx-auto mb-4" />
        <h2 className="text-xl font-semibold">Completing login...</h2>
        <p className="text-gray-500">Please wait while we sign you in</p>
      </div>
    </div>
  )
}
</file>

