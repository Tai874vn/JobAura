import { useAuthStore } from '@/stores/auth.store'
import { useChatStore } from '@/stores/chat.store'
import { useChatSocket } from '@/hooks/use-chat-socket'
import { ChatTrigger } from './chat-trigger'
import { ChatPanel } from './chat-panel'
import { ChatWindow } from './chat-window'

export function ChatContainer() {
  const { isAuthenticated, _hasHydrated } = useAuthStore()
  const isPanelOpen = useChatStore((s) => s.isPanelOpen)
  const openWindowRoomIds = useChatStore((s) => s.openWindowRoomIds)

  // Connect socket and wire events
  useChatSocket()

  if (!_hasHydrated || !isAuthenticated) return null

  return (
    <>
      <ChatTrigger />
      {isPanelOpen && <ChatPanel />}
      {openWindowRoomIds.map((roomId, index) => (
        <ChatWindow key={roomId} roomId={roomId} index={index} />
      ))}
    </>
  )
}
</file>

