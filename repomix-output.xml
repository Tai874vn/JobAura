import { create } from 'zustand'
import type { ChatRoom, ChatMessage, TypingUser } from '@/types/chat.types'

interface ChatState {
  // Data
  rooms: ChatRoom[]
  messages: Record<number, ChatMessage[]>
  onlineUserIds: Set<number>
  typingUsers: TypingUser[]

  // UI state
  isPanelOpen: boolean
  openWindowRoomIds: number[]
  minimizedRoomIds: Set<number>
  isSocketActive: boolean

  // Actions - Data
  setRooms: (rooms: ChatRoom[]) => void
  updateRoom: (room: ChatRoom) => void
  addMessageToRoom: (roomId: number, message: ChatMessage) => void
  setMessagesForRoom: (roomId: number, messages: ChatMessage[]) => void
  prependMessagesToRoom: (roomId: number, messages: ChatMessage[]) => void
  setOnlineUserIds: (ids: number[]) => void
  addOnlineUser: (id: number) => void
  removeOnlineUser: (id: number) => void
  addTypingUser: (user: TypingUser) => void
  removeTypingUser: (userId: number, roomId: number) => void
  clearUnreadCount: (roomId: number) => void
  incrementUnreadCount: (roomId: number) => void
  updateLastMessage: (roomId: number, message: ChatMessage) => void

  // Actions - UI
  togglePanel: () => void
  closePanel: () => void
  openWindow: (roomId: number) => void
  closeWindow: (roomId: number) => void
  minimizeWindow: (roomId: number) => void
  restoreWindow: (roomId: number) => void
  activateSocket: () => void

  // Computed
  totalUnreadCount: () => number
  isChatOpen: () => boolean
}

const MAX_WINDOWS = 3

export const useChatStore = create<ChatState>()((set, get) => ({
  rooms: [],
  messages: {},
  onlineUserIds: new Set(),
  typingUsers: [],
  isPanelOpen: false,
  openWindowRoomIds: [],
  minimizedRoomIds: new Set(),
  isSocketActive: false,

  setRooms: (rooms) => set({ rooms }),

  updateRoom: (room) =>
    set((state) => ({
      rooms: state.rooms.map((r) => (r.id === room.id ? room : r)),
    })),

  addMessageToRoom: (roomId, message) =>
    set((state) => ({
      messages: {
        ...state.messages,
        [roomId]: [...(state.messages[roomId] || []), message],
      },
    })),

  setMessagesForRoom: (roomId, messages) =>
    set((state) => ({
      messages: { ...state.messages, [roomId]: messages },
    })),

  prependMessagesToRoom: (roomId, messages) =>
    set((state) => ({
      messages: {
        ...state.messages,
        [roomId]: [...messages, ...(state.messages[roomId] || [])],
      },
    })),

  setOnlineUserIds: (ids) => set({ onlineUserIds: new Set(ids) }),

  addOnlineUser: (id) =>
    set((state) => {
      const next = new Set(state.onlineUserIds)
      next.add(id)
      return { onlineUserIds: next }
    }),

  removeOnlineUser: (id) =>
    set((state) => {
      const next = new Set(state.onlineUserIds)
      next.delete(id)
      return { onlineUserIds: next }
    }),

  addTypingUser: (user) =>
    set((state) => {
      const exists = state.typingUsers.some(
        (t) => t.userId === user.userId && t.roomId === user.roomId
      )
      if (exists) return state
      return { typingUsers: [...state.typingUsers, user] }
    }),

  removeTypingUser: (userId, roomId) =>
    set((state) => ({
      typingUsers: state.typingUsers.filter(
        (t) => !(t.userId === userId && t.roomId === roomId)
      ),
    })),

  clearUnreadCount: (roomId) =>
    set((state) => ({
      rooms: state.rooms.map((r) =>
        r.id === roomId ? { ...r, unreadCount: 0 } : r
      ),
    })),

  incrementUnreadCount: (roomId) =>
    set((state) => ({
      rooms: state.rooms.map((r) =>
        r.id === roomId ? { ...r, unreadCount: r.unreadCount + 1 } : r
      ),
    })),

  updateLastMessage: (roomId, message) =>
    set((state) => ({
      rooms: state.rooms
        .map((r) =>
          r.id === roomId
            ? { ...r, lastMessage: message, updatedAt: message.createdAt }
            : r
        )
        .sort(
          (a, b) =>
            new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
        ),
    })),

  togglePanel: () =>
    set((state) => {
      if (!state.isSocketActive) return { isPanelOpen: !state.isPanelOpen, isSocketActive: true }
      return { isPanelOpen: !state.isPanelOpen }
    }),

  closePanel: () => set({ isPanelOpen: false }),

  openWindow: (roomId) =>
    set((state) => {
      const activate = !state.isSocketActive ? { isSocketActive: true } : {}
      if (state.openWindowRoomIds.includes(roomId)) {
        const next = new Set(state.minimizedRoomIds)
        next.delete(roomId)
        return { minimizedRoomIds: next, isPanelOpen: false, ...activate }
      }
      let next = [...state.openWindowRoomIds, roomId]
      if (next.length > MAX_WINDOWS) {
        next = next.slice(next.length - MAX_WINDOWS)
      }
      return { openWindowRoomIds: next, isPanelOpen: false, ...activate }
    }),

  closeWindow: (roomId) =>
    set((state) => {
      const next = new Set(state.minimizedRoomIds)
      next.delete(roomId)
      return {
        openWindowRoomIds: state.openWindowRoomIds.filter((id) => id !== roomId),
        minimizedRoomIds: next,
      }
    }),

  minimizeWindow: (roomId) =>
    set((state) => {
      const next = new Set(state.minimizedRoomIds)
      next.add(roomId)
      return { minimizedRoomIds: next }
    }),

  restoreWindow: (roomId) =>
    set((state) => {
      const next = new Set(state.minimizedRoomIds)
      next.delete(roomId)
      return { minimizedRoomIds: next }
    }),

  activateSocket: () => set({ isSocketActive: true }),

  totalUnreadCount: () =>
    get().rooms.reduce((sum, r) => sum + r.unreadCount, 0),

  isChatOpen: () => {
    const s = get()
    return s.isPanelOpen || s.openWindowRoomIds.length > 0
  },
}))
</file>

