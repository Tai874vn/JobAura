import { useState, useRef } from 'react'
import { useNavigate } from 'react-router-dom'
import { useQuery, useMutation } from '@tanstack/react-query'
import { Upload, ArrowLeft } from 'lucide-react'
import { toast } from 'sonner'
import { Button, Card, CardContent, Input, Spinner, Label, Textarea } from '@/components/ui'
import { jobsApi, jobDetailTypesApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { getApiErrorMessage } from '@/lib/utils'
import type { CreateJob } from '@/schemas'

export function CreateJobPage() {
  const navigate = useNavigate()
  const fileInputRef = useRef<HTMLInputElement>(null)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [previewUrl, setPreviewUrl] = useState<string | null>(null)
  const [formData, setFormData] = useState<Partial<CreateJob>>({
    tenCongViec: '',
    giaTien: 0,
    moTaNgan: '',
    moTa: '',
    maChiTietLoai: 0,
  })

  const { data: jobDetailTypesData } = useQuery({
    queryKey: QUERY_KEYS.jobDetailTypes,
    queryFn: jobDetailTypesApi.getAll,
  })

  const createMutation = useMutation({
    mutationFn: async (data: CreateJob) => {
      const result = await jobsApi.create(data)
      if (selectedFile && result.content?.id) {
        await jobsApi.uploadImage(result.content.id, selectedFile)
      }
      return result
    },
    onSuccess: (result) => {
      toast.success('Job posted successfully!')
      navigate(`/jobs/${result.content.id}`)
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to create job')),
  })

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return
    setSelectedFile(file)
    setPreviewUrl(URL.createObjectURL(file))
  }

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()
    if (!formData.tenCongViec) {
      toast.error('Please enter a job name')
      return
    }
    if (!formData.maChiTietLoai) {
      toast.error('Please select a category')
      return
    }
    createMutation.mutate({
      tenCongViec: formData.tenCongViec,
      giaTien: formData.giaTien || 0,
      moTaNgan: formData.moTaNgan || '',
      moTa: formData.moTa || '',
      maChiTietLoai: formData.maChiTietLoai,
      danhGia: 0,
      saoCongViec: 0,
    })
  }

  const jobDetailTypes = jobDetailTypesData?.content || []

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-slate-950">
      <div className="container mx-auto max-w-2xl px-4 py-8">
        <Button variant="ghost" className="mb-6" onClick={() => navigate(-1)}>
          <ArrowLeft className="mr-2 h-4 w-4" />
          Back
        </Button>

        <h1 className="mb-6 text-3xl font-bold text-gray-900 dark:text-slate-50">Post a Job</h1>

        <Card>
          <CardContent className="p-6">
