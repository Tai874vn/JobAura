import { useState } from 'react'
import { useQuery, useMutation } from '@tanstack/react-query'
import { Trash2, Star } from 'lucide-react'
import { toast } from 'sonner'
import { Button, Card, CardContent, Input, Spinner } from '@/components/ui'
import { commentsApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { queryClient } from '@/lib/query-client'
import { getApiErrorMessage } from '@/lib/utils'

export function CommentsAdminPage() {
  const [searchKeyword, setSearchKeyword] = useState('')

  const { data, isLoading } = useQuery({
    queryKey: QUERY_KEYS.comments,
    queryFn: commentsApi.getAll,
  })

  const deleteMutation = useMutation({
    mutationFn: commentsApi.delete,
    onSuccess: () => {
      toast.success('Comment deleted successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.comments })
    },
    onError: (error) => {
      toast.error(getApiErrorMessage(error, 'Failed to delete comment'))
    },
  })

  const handleDelete = (id: number) => {
    if (confirm('Are you sure you want to delete this comment?')) {
      deleteMutation.mutate(id)
    }
  }

  const allComments = data?.content || []
  const comments = searchKeyword
    ? allComments.filter((c) =>
        c.noiDung.toLowerCase().includes(searchKeyword.toLowerCase())
      )
    : allComments

  return (
    <div className="p-8">
      <div className="mb-6">
        <h1 className="text-3xl font-bold">Manage Comments</h1>
        </div>

        <Card className="mb-6">
          <CardContent className="p-4">
            <Input
              placeholder="Search comments..."
              value={searchKeyword}
              onChange={(e) => setSearchKeyword(e.target.value)}
            />
          </CardContent>
        </Card>

        {isLoading ? (
          <div className="flex justify-center py-12">
            <Spinner size="lg" />
          </div>
        ) : comments.length === 0 ? (
          <Card>
            <CardContent className="flex flex-col items-center justify-center py-12">
              <p className="text-gray-500">No comments found</p>
            </CardContent>
          </Card>
        ) : (
          <div className="space-y-4">
            {comments.map((comment) => (
              <Card key={comment.id}>
                <CardContent className="flex items-start justify-between p-6">
                  <div className="flex-1">
                    <div className="flex items-center gap-3">
                      {comment.nguoiDung?.avatar ? (
                        <img
                          src={comment.nguoiDung.avatar}
                          alt={comment.nguoiDung.name}
                          className="h-10 w-10 rounded-full object-cover"
                        />
                      ) : (
                        <div className="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
                          {comment.nguoiDung?.name?.[0]?.toUpperCase() || 'U'}
                        </div>
                      )}
                      <div>
                        <h3 className="font-semibold">
                          {comment.nguoiDung?.name || `User #${comment.maNguoiBinhLuan}`}
                        </h3>
                        <div className="flex items-center gap-1">
                          {Array.from({ length: 5 }).map((_, i) => (
                            <Star
                              key={i}
                              className={`h-3 w-3 ${
                                i < comment.saoBinhLuan
                                  ? 'fill-yellow-400 text-yellow-400'
                                  : 'text-gray-300'
                              }`}
                            />
                          ))}
                        </div>
                      </div>
                    </div>
                    <p className="mt-3 text-gray-700">{comment.noiDung}</p>
                    <div className="mt-2 text-sm text-gray-500">
                      <span>Job ID: {comment.maCongViec}</span>
                      {comment.ngayBinhLuan && (
                        <span className="ml-4">
                          {new Date(comment.ngayBinhLuan).toLocaleDateString()}
                        </span>
                      )}
                    </div>
                  </div>
                  <Button
                    variant="destructive"
                    size="sm"
                    onClick={() => handleDelete(comment.id)}
                    disabled={deleteMutation.isPending}
                  >
                    <Trash2 className="h-4 w-4" />
                  </Button>
                </CardContent>
              </Card>
            ))}
          </div>
        )}
    </div>
  )
}
