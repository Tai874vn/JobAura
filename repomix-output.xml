                )}
                {job.moTa && (
                  <p className="whitespace-pre-wrap text-[15px] leading-[1.75] text-zinc-600 dark:text-slate-300">{job.moTa}</p>
                )}
              </div>
            )}

            {/* ── Reviews ── */}
            <div className="rounded-xl bg-white dark:bg-slate-800 p-6 shadow-sm animate-fade-in-up animate-delay-300">
              <div className="mb-5 flex items-center justify-between">
                <h2 className="text-base font-bold text-zinc-900 dark:text-slate-50">
                  Reviews
                  <span className="ml-1.5 text-sm font-normal text-zinc-400 dark:text-slate-500">({reviewCount})</span>
                </h2>
                {reviewCount > 0 && (
                  <div className="flex items-center gap-1.5 rounded-full bg-amber-50 dark:bg-amber-900/20 px-2.5 py-1">
                    <Star className="h-3.5 w-3.5 fill-amber-400 text-amber-400" />
                    <span className="text-xs font-bold text-amber-700 dark:text-amber-400">{job.saoCongViec || 0}</span>
                  </div>
                )}
              </div>

              {reviewCount === 0 && (
                <div className="flex flex-col items-center gap-2 py-8 text-center">
                  <MessageSquare className="h-8 w-8 text-zinc-200 dark:text-slate-700" />
                  <p className="text-sm text-zinc-400 dark:text-slate-500">No reviews yet</p>
                </div>
              )}

              <div className="divide-y divide-zinc-50 dark:divide-slate-700">
                {job.binhLuans?.map((c) => (
                  <div key={c.id} className="py-4 first:pt-0 last:pb-0">
                    <div className="flex items-start gap-3">
                      {c.nguoiDung?.avatar ? (
                        <img src={c.nguoiDung.avatar} alt={c.nguoiDung.name} className="mt-0.5 h-8 w-8 rounded-full object-cover" />
                      ) : (
                        <div className="mt-0.5 flex h-8 w-8 items-center justify-center rounded-full bg-zinc-100 dark:bg-slate-700">
                          <User className="h-3.5 w-3.5 text-zinc-400 dark:text-slate-500" />
                        </div>
                      )}
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center gap-2">
                          <Link to={`/profile/${c.nguoiDung?.id}`} className="text-sm font-semibold text-zinc-800 dark:text-slate-200 hover:underline">
                            {c.nguoiDung?.name}
                          </Link>
                          <StarRating value={c.saoBinhLuan} />
                          {c.ngayBinhLuan && (
                            <span className="text-xs text-zinc-300 dark:text-slate-600">{formatDate(c.ngayBinhLuan)}</span>
                          )}
                        </div>
                        <p className="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-slate-400">{c.noiDung}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              {/* Write review */}
              {isAuthenticated && (
                <div className="mt-6 rounded-lg border border-zinc-100 dark:border-slate-700 bg-zinc-50/60 dark:bg-slate-900/60 p-4">
                  <h4 className="mb-3 flex items-center gap-1.5 text-sm font-bold text-zinc-700 dark:text-slate-300">
                    <Sparkles className="h-3.5 w-3.5 text-amber-400" />
                    Write a Review
                  </h4>

                  <div className="mb-3">
                    <div className="flex items-center gap-1">
                      {[1, 2, 3, 4, 5].map((star) => (
                        <button
                          key={star}
                          type="button"
                          onClick={() => setRating(star)}
                          onMouseEnter={() => setHoveredStar(star)}
                          onMouseLeave={() => setHoveredStar(0)}
                          className="cursor-pointer transition-transform duration-150 hover:scale-110"
                        >
                          <Star
                            className={`h-6 w-6 transition-colors duration-100 ${
                              star <= (hoveredStar || rating)
                                ? 'fill-amber-400 text-amber-400'
                                : 'text-zinc-200 hover:text-amber-200'
                            }`}
                          />
                        </button>
                      ))}
                      <span className="ml-2 text-sm text-zinc-400 dark:text-slate-500">{hoveredStar || rating}/5</span>
                    </div>
                  </div>

                  <Textarea
                    placeholder="Share your experience..."
                    value={comment}
                    onChange={(e) => setComment(e.target.value)}
                    className="min-h-[90px] resize-none rounded-lg border-zinc-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm"
                  />
                  <div className="mt-2 flex justify-end">
                    <Button onClick={handleComment} disabled={commentMutation.isPending || !comment.trim()} size="sm">
                      {commentMutation.isPending ? 'Posting...' : 'Submit Review'}
                    </Button>
                  </div>
                </div>
              )}

              {!isAuthenticated && (
                <div className="mt-6 flex items-center justify-between rounded-lg border border-dashed border-zinc-200 dark:border-slate-700 px-4 py-3">
                  <p className="text-sm text-zinc-500 dark:text-slate-400">Sign in to leave a review</p>
                  <Button variant="outline" size="sm" onClick={() => navigate('/auth/login')}>Sign In</Button>
                </div>
              )}
            </div>
          </div>

          {/* ── Right column ── */}
          <div className="lg:col-span-4">
            <div className="sticky top-6 space-y-4 animate-fade-in-up animate-delay-200">
              {/* Price card */}
              <div className="overflow-hidden rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-zinc-100 dark:border-slate-700">
                <div className="bg-gradient-to-br from-zinc-800 to-zinc-950 dark:from-slate-900 dark:to-slate-950 px-5 py-5 text-white">
                  <p className="text-[11px] font-medium uppercase tracking-widest text-zinc-400 dark:text-slate-500">Service Price</p>
                  <span className="mt-1 block text-3xl font-extrabold tracking-tight text-white dark:text-slate-50">${job.giaTien}</span>
                </div>

                <div className="p-5">
                  {isOwner ? (
                    <div className="space-y-2.5">
                      <div className="flex items-center gap-2 rounded-lg bg-zinc-50 dark:bg-slate-900 px-3 py-2 text-sm text-zinc-500 dark:text-slate-400">
                        <Shield className="h-4 w-4" />
                        Your listing
                      </div>
                      <Button
                        className="w-full"
                        variant="outline"
                        onClick={() => {
                          setEditFormData({
                            tenCongViec: job.tenCongViec,
                            giaTien: job.giaTien,
                            moTaNgan: job.moTaNgan || '',
                            moTa: job.moTa || '',
                            maChiTietLoai: job.maChiTietLoai,
                          })
                          setEditPreviewUrl(job.hinhAnh || null)
                          setSelectedFile(null)
                          setIsEditModalOpen(true)
                        }}
                      >
                        <Pencil className="mr-2 h-4 w-4" />
                        Edit
                      </Button>
                      <Button
                        className="w-full"
                        variant="destructive"
                        onClick={() => {
                          if (confirm(`Delete "${job.tenCongViec}"?`)) deleteMutation.mutate()
                        }}
                        disabled={deleteMutation.isPending}
                      >
                        <Trash2 className="mr-2 h-4 w-4" />
                        {deleteMutation.isPending ? 'Deleting...' : 'Delete'}
                      </Button>
                    </div>
                  ) : (
                    <Button
                      className="w-full"
                      size="lg"
                      onClick={handleHire}
                      disabled={hireMutation.isPending || hireMutation.isSuccess}
                    >
                      {hireMutation.isPending ? (
                        <><Spinner size="sm" className="mr-2" />Processing...</>
                      ) : hireMutation.isSuccess ? (
                        <><CheckCircle2 className="mr-2 h-5 w-5" />Hired!</>
                      ) : (
                        'Continue to Hire'
                      )}
                    </Button>
                  )}
                </div>
              </div>

              {/* Seller card */}
              {job.nguoiDung && (
                <Link
                  to={`/profile/${job.nguoiDung.id}`}
                  className="group flex items-center gap-3 rounded-xl bg-white dark:bg-slate-800 border border-zinc-100 dark:border-slate-700 p-4 shadow-sm transition-shadow hover:shadow-md"
                >
                  {job.nguoiDung.avatar ? (
                    <img src={job.nguoiDung.avatar} alt={job.nguoiDung.name} className="h-11 w-11 rounded-full object-cover ring-2 ring-zinc-50 dark:ring-slate-700" />
                  ) : (
                    <div className="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-zinc-700 to-zinc-900 dark:from-slate-700 dark:to-slate-900 text-xs font-bold text-white">
                      {sellerInitials}
                    </div>
                  )}
                  <div className="flex-1 min-w-0">
                    <p className="truncate text-sm font-semibold text-zinc-800 dark:text-slate-200 group-hover:text-zinc-600 dark:group-hover:text-slate-400">{job.nguoiDung.name}</p>
                    <p className="text-xs text-zinc-400 dark:text-slate-500">View profile</p>
                  </div>
                  <ChevronRight className="h-4 w-4 text-zinc-300 dark:text-slate-600 transition-transform group-hover:translate-x-0.5" />
                </Link>
              )}

              {/* Details card */}
              <div className="rounded-xl bg-white dark:bg-slate-800 border border-zinc-100 dark:border-slate-700 p-5 shadow-sm">
                <h3 className="mb-3 text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-slate-500">Details</h3>
                <div className="space-y-3">
                  {job.chiTietLoaiCongViec?.loaiCongViec && (
                    <div className="flex items-center justify-between text-sm">
                      <span className="text-zinc-400 dark:text-slate-500">Category</span>
                      <span className="font-medium text-zinc-700 dark:text-slate-300">{job.chiTietLoaiCongViec.loaiCongViec.tenLoaiCongViec}</span>
                    </div>
                  )}
                  {job.chiTietLoaiCongViec && (
                    <div className="flex items-center justify-between text-sm">
                      <span className="text-zinc-400 dark:text-slate-500">Subcategory</span>
                      <span className="font-medium text-zinc-700 dark:text-slate-300">{job.chiTietLoaiCongViec.tenChiTiet}</span>
                    </div>
                  )}
                  <div className="flex items-center justify-between text-sm">
                    <span className="text-zinc-400 dark:text-slate-500">Rating</span>
                    <div className="flex items-center gap-1.5">
                      <Star className="h-3.5 w-3.5 fill-amber-400 text-amber-400" />
                      <span className="font-medium text-zinc-700 dark:text-slate-300">{job.saoCongViec || 0} / 5</span>
                    </div>
                  </div>
                  <div className="flex items-center justify-between text-sm">
                    <span className="text-zinc-400 dark:text-slate-500">Reviews</span>
                    <span className="font-medium text-zinc-700 dark:text-slate-300">{job.danhGia || 0}</span>
                  </div>
                  {job.createdAt && (
                    <div className="flex items-center justify-between text-sm">
                      <span className="text-zinc-400 dark:text-slate-500">Posted</span>
                      <span className="font-medium text-zinc-700 dark:text-slate-300">{formatDate(job.createdAt)}</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="h-12" />

      {/* ── Edit Modal ── */}
      <Modal isOpen={isEditModalOpen} onClose={() => setIsEditModalOpen(false)} title="Edit Job" className="max-w-xl">
        <form
          onSubmit={(e) => {
            e.preventDefault()
            if (!editFormData.tenCongViec || !editFormData.maChiTietLoai) {
              toast.error('Please fill in required fields')
              return
            }
            updateMutation.mutate(editFormData)
          }}
          className="space-y-4"
        >
          <div>
            <Label>Image</Label>
            <input
              ref={editFileInputRef}
              type="file"
              accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
              onChange={(e) => {
                const file = e.target.files?.[0]
                if (!file) return
                if (editPreviewUrl?.startsWith('blob:')) URL.revokeObjectURL(editPreviewUrl)
                setSelectedFile(file)
                setEditPreviewUrl(URL.createObjectURL(file))
              }}
              className="hidden"
            />
            <div
              onClick={() => editFileInputRef.current?.click()}
              className="mt-1 flex cursor-pointer items-center justify-center rounded-lg border-2 border-dashed border-gray-300 dark:border-slate-700 p-4 transition-colors hover:border-gray-400 dark:hover:border-slate-600"
            >
              {editPreviewUrl ? (
                <img src={editPreviewUrl} alt="Preview" className="h-32 w-full rounded-md object-cover" />
              ) : (
                <div className="flex flex-col items-center gap-2 text-gray-400 dark:text-slate-500">
                  <Upload className="h-8 w-8" />
                  <span className="text-sm">Click to upload image</span>
                </div>
              )}
            </div>
          </div>

          <div>
            <Label htmlFor="edit-tenCongViec">Job Name *</Label>
            <Input
              id="edit-tenCongViec"
              value={editFormData.tenCongViec}
              onChange={(e) => setEditFormData({ ...editFormData, tenCongViec: e.target.value })}
              placeholder="Enter job name"
            />
          </div>

          <div>
            <Label htmlFor="edit-maChiTietLoai">Category *</Label>
            <select
              id="edit-maChiTietLoai"
              value={editFormData.maChiTietLoai}
              onChange={(e) => setEditFormData({ ...editFormData, maChiTietLoai: Number(e.target.value) })}
              className="w-full rounded-md border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-900 dark:text-slate-50 px-3 py-2"
            >
              <option value={0}>Select category</option>
              {(jobDetailTypesData?.content || []).map((type) => (
                <option key={type.id} value={type.id}>{type.tenChiTiet}</option>
              ))}
            </select>
          </div>

          <div>
            <Label htmlFor="edit-giaTien">Price ($)</Label>
            <Input
              id="edit-giaTien"
              type="number"
              value={editFormData.giaTien}
              onChange={(e) => setEditFormData({ ...editFormData, giaTien: Number(e.target.value) })}
            />
          </div>

          <div>
            <Label htmlFor="edit-moTaNgan">Short Description</Label>
            <Input
              id="edit-moTaNgan"
              value={editFormData.moTaNgan}
              onChange={(e) => setEditFormData({ ...editFormData, moTaNgan: e.target.value })}
            />
          </div>

          <div>
            <Label htmlFor="edit-moTa">Full Description</Label>
            <Textarea
              id="edit-moTa"
              value={editFormData.moTa}
              onChange={(e) => setEditFormData({ ...editFormData, moTa: e.target.value })}
              rows={4}
            />
          </div>

          <div className="flex justify-end gap-2 pt-4">
            <Button type="button" variant="outline" onClick={() => setIsEditModalOpen(false)}>Cancel</Button>
            <Button type="submit" disabled={updateMutation.isPending}>
              {updateMutation.isPending && <Spinner size="sm" className="mr-2" />}
              Update
            </Button>
          </div>
        </form>
      </Modal>
    </div>
  )
}
</file>

</files>
