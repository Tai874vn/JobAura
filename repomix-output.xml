<file path="src/components/auth/login-popup.tsx">
import { useEffect } from 'react'
import { Link } from 'react-router-dom'
import { X } from 'lucide-react'
import { Button } from '@/components/ui'
import { usePopupStore } from '@/stores/popup.store'
import { useAuthStore } from '@/stores/auth.store'
import { initiateGoogleLogin } from '@/lib/oauth'
import popupImage from '@/assets/popup.avif'

const POPUP_SEEN_KEY = 'login-popup-seen'

export function LoginPopup() {
  const { isLoginPopupOpen, openLoginPopup, closeLoginPopup } = usePopupStore()
  const { isAuthenticated, _hasHydrated } = useAuthStore()

  // Auto-show popup for first-time visitors who are not logged in
  useEffect(() => {
    if (!_hasHydrated) return

    const hasSeenPopup = localStorage.getItem(POPUP_SEEN_KEY)

    if (!hasSeenPopup && !isAuthenticated) {
      openLoginPopup()
    }
  }, [_hasHydrated, isAuthenticated, openLoginPopup])

  // Mark popup as seen when closed
  const handleClose = () => {
    localStorage.setItem(POPUP_SEEN_KEY, 'true')
    closeLoginPopup()
  }

  useEffect(() => {
    const onEscape = (e: KeyboardEvent) => {
      if (e.key === 'Escape') handleClose()
    }

    if (isLoginPopupOpen) {
      document.addEventListener('keydown', onEscape)
      document.body.style.overflow = 'hidden'
    }

    return () => {
      document.removeEventListener('keydown', onEscape)
      document.body.style.overflow = 'unset'
    }
  }, [isLoginPopupOpen])

  if (!isLoginPopupOpen) return null

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center">
      {/* Backdrop */}
      <div
        className="absolute inset-0 bg-black/60 dark:bg-black/80"
        onClick={handleClose}
      />

      {/* Popup */}
      <div className="relative z-10 flex w-full max-w-3xl overflow-hidden rounded-2xl bg-white dark:bg-slate-800 shadow-2xl">
        {/* Close button */}
        <button
          onClick={handleClose}
          className="absolute right-4 top-4 z-20 rounded-full bg-white/80 dark:bg-slate-700/80 p-1.5 text-zinc-600 dark:text-slate-300 transition-colors hover:bg-zinc-100 dark:hover:bg-slate-600 hover:text-zinc-900 dark:hover:text-slate-100"
        >
          <X className="h-5 w-5" />
        </button>

        {/* Left side - Image */}
        <div className="hidden w-1/2 md:block">
          <img
            src={popupImage}
            alt="Join our community"
            className="h-full w-full object-cover"
          />
        </div>

        {/* Right side - Content */}
        <div className="flex w-full flex-col justify-center p-8 md:w-1/2">
          <div className="mb-6">
            <h2 className="text-2xl font-bold text-zinc-900 dark:text-slate-50">
              Join our community
            </h2>
            <p className="mt-2 text-zinc-600 dark:text-slate-300">
              Sign in to access all features and connect with professionals
            </p>
          </div>

          <div className="space-y-4">
            {/* Google Login */}
            <Button
              variant="outline"
              className="w-full justify-center py-5"
              onClick={() => {
                handleClose()
                initiateGoogleLogin()
              }}
            >
              <svg className="mr-2 h-5 w-5" viewBox="0 0 24 24">
                <path
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  fill="#4285F4"
                />
                <path
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  fill="#34A853"
                />
                <path
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                  fill="#FBBC05"
                />
                <path
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  fill="#EA4335"
                />
              </svg>
              <div>Continue with Google</div>
            </Button>

            <div className="relative">
              <div className="absolute inset-0 flex items-center">
                <span className="w-full border-t border-zinc-200 dark:border-slate-700" />
              </div>
              <div className="relative flex justify-center text-xs uppercase">
                <span className="bg-white dark:bg-slate-800 px-2 text-zinc-500 dark:text-slate-400">Or</span>
              </div>
            </div>

            {/* Sign in with email */}
            <Link to="/auth/login" onClick={handleClose}>
              <Button className="w-full py-5">
                Sign in with Email
              </Button>
            </Link>
          </div>

          <div className="mt-6 text-center text-sm text-zinc-600 dark:text-slate-400">
            Don't have an account?{' '}
            <Link
              to="/auth/register"
              onClick={handleClose}
              className="font-medium text-zinc-900 dark:text-slate-50 hover:underline"
            >
              Create one
            </Link>
          </div>

          <button
            onClick={handleClose}
            className="mt-4 text-center text-sm hover:text-blue-500 dark:hover:text-blue-400 underline decoration-blue-500 dark:decoration-blue-400 text-blue-700 dark:text-blue-400"
          >
            Continue without signing in
          </button>
        </div>
      </div>
    </div>
  )
}
</file>

