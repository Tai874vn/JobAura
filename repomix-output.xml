import { useState, useRef } from 'react'
import { useQuery, useMutation } from '@tanstack/react-query'
import { Pencil, Trash2, Plus, Upload, ImageIcon } from 'lucide-react'
import { toast } from 'sonner'
import { Button, Card, CardContent, Input, Badge, Spinner, Pagination, Modal, Label, Textarea } from '@/components/ui'
import { jobsApi, jobDetailTypesApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { queryClient } from '@/lib/query-client'
import { getApiErrorMessage } from '@/lib/utils'
import type { Job, CreateJob } from '@/schemas'

export function JobsAdminPage() {
  const [searchKeyword, setSearchKeyword] = useState('')
  const [page, setPage] = useState(1)
  const [isModalOpen, setIsModalOpen] = useState(false)
  const [editingJob, setEditingJob] = useState<Job | null>(null)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [previewUrl, setPreviewUrl] = useState<string | null>(null)
  const fileInputRef = useRef<HTMLInputElement>(null)
  const [formData, setFormData] = useState<Partial<CreateJob>>({
    tenCongViec: '',
    giaTien: 0,
    moTaNgan: '',
    moTa: '',
    maChiTietLoai: 0,
    danhGia: 0,
    saoCongViec: 0,
  })
  const pageSize = 10

  const { data, isLoading } = useQuery({
    queryKey: [...QUERY_KEYS.jobs, page, pageSize, searchKeyword],
    queryFn: () => jobsApi.getPaginated({ page, pageSize, keyword: searchKeyword || undefined }),
  })

  const { data: jobDetailTypesData } = useQuery({
    queryKey: QUERY_KEYS.jobDetailTypes,
    queryFn: jobDetailTypesApi.getAll,
  })

  const createMutation = useMutation({
    mutationFn: async (data: CreateJob) => {
      const result = await jobsApi.create(data)
      if (selectedFile && result.content?.id) {
        await jobsApi.uploadImage(result.content.id, selectedFile)
      }
      return result
    },
    onSuccess: () => {
      toast.success('Job created successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
      closeModal()
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to create job')),
  })

  const updateMutation = useMutation({
    mutationFn: async ({ id, data }: { id: number; data: Partial<CreateJob> }) => {
      const result = await jobsApi.update(id, data)
      if (selectedFile) {
        await jobsApi.uploadImage(id, selectedFile)
      }
      return result
    },
    onSuccess: () => {
      toast.success('Job updated successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
      closeModal()
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to update job')),
  })

  const deleteMutation = useMutation({
    mutationFn: jobsApi.delete,
    onSuccess: () => {
      toast.success('Job deleted successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to delete job')),
  })

  const handleDelete = (id: number, name: string) => {
    if (confirm(`Are you sure you want to delete "${name}"?`)) {
      deleteMutation.mutate(id)
    }
  }

  const handleSearch = (e: React.ChangeEvent<HTMLInputElement>) => {
    setSearchKeyword(e.target.value)
    setPage(1)
  }

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return
    setSelectedFile(file)
    setPreviewUrl(URL.createObjectURL(file))
  }

  const openCreateModal = () => {
    setEditingJob(null)
    setSelectedFile(null)
    setPreviewUrl(null)
    setFormData({
      tenCongViec: '',
      giaTien: 0,
      moTaNgan: '',
      moTa: '',
      maChiTietLoai: jobDetailTypesData?.content?.[0]?.id || 0,
      danhGia: 0,
      saoCongViec: 0,
    })
    setIsModalOpen(true)
  }

  const openEditModal = (job: Job) => {
    setEditingJob(job)
    setSelectedFile(null)
    setPreviewUrl(job.hinhAnh || null)
    setFormData({
      tenCongViec: job.tenCongViec,
      giaTien: job.giaTien,
      moTaNgan: job.moTaNgan || '',
      moTa: job.moTa || '',
      maChiTietLoai: job.maChiTietLoai,
      danhGia: job.danhGia,
      saoCongViec: job.saoCongViec,
    })
    setIsModalOpen(true)
  }

  const closeModal = () => {
    setIsModalOpen(false)
    setEditingJob(null)
    setSelectedFile(null)
    setPreviewUrl(null)
  }

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()
    if (!formData.tenCongViec || !formData.maChiTietLoai) {
      toast.error('Please fill in required fields')
      return
    }

    if (editingJob) {
      updateMutation.mutate({ id: editingJob.id, data: formData })
    } else {
      createMutation.mutate(formData as CreateJob)
    }
  }

  const jobs = data?.content?.data || []
  const totalPages = data?.content?.totalPages || 1
  const jobDetailTypes = jobDetailTypesData?.content || []
  const isSaving = createMutation.isPending || updateMutation.isPending

  return (
    <div className="p-8">
      <div className="mb-6 flex items-center justify-between">
        <h1 className="text-3xl font-bold">Manage Jobs</h1>
        <Button onClick={openCreateModal}>
          <Plus className="mr-2 h-4 w-4" />
          Add Job
        </Button>
      </div>

      <Card className="mb-6">
        <CardContent className="p-4">
          <Input
            placeholder="Search jobs..."
            value={searchKeyword}
            onChange={handleSearch}
          />
        </CardContent>
      </Card>

      {isLoading ? (
        <div className="flex justify-center py-12">
          <Spinner size="lg" />
        </div>
      ) : jobs.length === 0 ? (
        <Card>
          <CardContent className="flex flex-col items-center justify-center py-12">
            <p className="text-gray-500">No jobs found</p>
          </CardContent>
        </Card>
      ) : (
        <>
          <div className="space-y-4">
            {jobs.map((job) => (
              <Card key={job.id}>
                <CardContent className="flex items-center justify-between p-6">
                  <div className="flex items-center gap-4">
                    {job.hinhAnh ? (
                      <img src={job.hinhAnh} alt={job.tenCongViec} className="h-14 w-14 rounded-lg object-cover" />
                    ) : (
                      <div className="flex h-14 w-14 items-center justify-center rounded-lg bg-gray-100">
                        <ImageIcon className="h-6 w-6 text-gray-400" />
                      </div>
                    )}
                    <div className="flex-1">
                      <div className="flex items-center gap-3">
                        <h3 className="text-lg font-semibold">{job.tenCongViec}</h3>
                        <Badge variant="secondary">${job.giaTien}</Badge>
                      </div>
                      <p className="mt-1 text-sm text-gray-500 line-clamp-1">{job.moTaNgan}</p>
                    </div>
                  </div>
                  <div className="flex gap-2">
                    <Button variant="outline" size="sm" onClick={() => openEditModal(job)}>
                      <Pencil className="h-4 w-4" />
                    </Button>
                    <Button
                      variant="destructive"
                      size="sm"
                      onClick={() => handleDelete(job.id, job.tenCongViec)}
                      disabled={deleteMutation.isPending}
                    >
                      <Trash2 className="h-4 w-4" />
                    </Button>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>

          <div className="mt-6">
            <Pagination currentPage={page} totalPages={totalPages} onPageChange={setPage} />
          </div>
        </>
      )}

      {/* Create/Edit Modal */}
      <Modal isOpen={isModalOpen} onClose={closeModal} title={editingJob ? 'Edit Job' : 'Create New Job'} className="max-w-xl">
        <form onSubmit={handleSubmit} className="space-y-4">
          {/* Image Upload */}
          <div>
            <Label>Image</Label>
            <input
              ref={fileInputRef}
              type="file"
              accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
              onChange={handleFileChange}
              className="hidden"
            />
            <div
              onClick={() => fileInputRef.current?.click()}
              className="mt-1 flex cursor-pointer items-center justify-center rounded-lg border-2 border-dashed border-gray-300 p-4 transition-colors hover:border-gray-400"
            >
              {previewUrl ? (
                <img src={previewUrl} alt="Preview" className="h-32 w-full rounded-md object-cover" />
              ) : (
                <div className="flex flex-col items-center gap-2 text-gray-400">
                  <Upload className="h-8 w-8" />
                  <span className="text-sm">Click to upload image</span>
                </div>
              )}
            </div>
          </div>

          <div>
            <Label htmlFor="tenCongViec">Job Name *</Label>
            <Input
              id="tenCongViec"
              value={formData.tenCongViec}
              onChange={(e) => setFormData({ ...formData, tenCongViec: e.target.value })}
              placeholder="Enter job name"
            />
          </div>

          <div>
            <Label htmlFor="maChiTietLoai">Category *</Label>
            <select
              id="maChiTietLoai"
              value={formData.maChiTietLoai}
              onChange={(e) => setFormData({ ...formData, maChiTietLoai: Number(e.target.value) })}
              className="w-full rounded-md border border-gray-300 px-3 py-2"
            >
              <option value={0}>Select category</option>
              {jobDetailTypes.map((type) => (
                <option key={type.id} value={type.id}>{type.tenChiTiet}</option>
              ))}
            </select>
          </div>

          <div>
            <Label htmlFor="giaTien">Price ($)</Label>
            <Input
              id="giaTien"
              type="number"
              value={formData.giaTien}
              onChange={(e) => setFormData({ ...formData, giaTien: Number(e.target.value) })}
            />
          </div>

          <div>
            <Label htmlFor="moTaNgan">Short Description</Label>
            <Input
              id="moTaNgan"
              value={formData.moTaNgan}
              onChange={(e) => setFormData({ ...formData, moTaNgan: e.target.value })}
            />
          </div>

          <div>
            <Label htmlFor="moTa">Full Description</Label>
            <Textarea
              id="moTa"
              value={formData.moTa}
              onChange={(e) => setFormData({ ...formData, moTa: e.target.value })}
              rows={4}
            />
          </div>

          <div className="flex justify-end gap-2 pt-4">
            <Button type="button" variant="outline" onClick={closeModal}>Cancel</Button>
            <Button type="submit" disabled={isSaving}>
              {isSaving && <Spinner size="sm" className="mr-2" />}
              {editingJob ? 'Update' : 'Create'}
            </Button>
          </div>
        </form>
      </Modal>
    </div>
  )
}
</file>

