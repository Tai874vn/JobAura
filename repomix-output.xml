<file path="src/components/chat/chat-window-messages.tsx">
import { useEffect, useRef, useCallback } from 'react'
import { Loader2 } from 'lucide-react'
import { MessageBubble } from './message-bubble'
import { TypingIndicator } from './typing-indicator'
import type { ChatMessage } from '@/types/chat.types'

interface ChatWindowMessagesProps {
  messages: ChatMessage[]
  currentUserId: number | undefined
  typingNames: string[]
  isLoadingOlder: boolean
  hasMore: boolean
  onLoadOlder: () => void
}

export function ChatWindowMessages({
  messages,
  currentUserId,
  typingNames,
  isLoadingOlder,
  hasMore,
  onLoadOlder,
}: ChatWindowMessagesProps) {
  const scrollRef = useRef<HTMLDivElement>(null)
  const sentinelRef = useRef<HTMLDivElement>(null)
  const prevMessagesLenRef = useRef(0)
  const isAtBottomRef = useRef(true)

  // Track scroll position
  const handleScroll = () => {
    const el = scrollRef.current
    if (!el) return
    isAtBottomRef.current =
      el.scrollHeight - el.scrollTop - el.clientHeight < 40
  }

  // Auto-scroll to bottom on new messages
  useEffect(() => {
    if (messages.length > prevMessagesLenRef.current) {
      const isNewMessage =
        messages.length > 0 &&
        prevMessagesLenRef.current > 0 &&
        messages[messages.length - 1]?.id !==
          messages[prevMessagesLenRef.current - 1]?.id

      // Scroll to bottom on new message if already near bottom or if it's our message
      if (isAtBottomRef.current || !isNewMessage) {
        requestAnimationFrame(() => {
          scrollRef.current?.scrollTo({
            top: scrollRef.current.scrollHeight,
            behavior: isNewMessage ? 'smooth' : 'instant',
          })
        })
      }
    }
    prevMessagesLenRef.current = messages.length
  }, [messages.length])

  // Initial scroll to bottom
  useEffect(() => {
    requestAnimationFrame(() => {
      if (scrollRef.current) {
        scrollRef.current.scrollTop = scrollRef.current.scrollHeight
      }
    })
  }, [])

  // Intersection observer for loading older messages
  const observerCallback = useCallback(
    (entries: IntersectionObserverEntry[]) => {
      if (entries[0]?.isIntersecting && hasMore && !isLoadingOlder) {
        onLoadOlder()
      }
    },
    [hasMore, isLoadingOlder, onLoadOlder]
  )

  useEffect(() => {
    const sentinel = sentinelRef.current
    if (!sentinel) return
    const observer = new IntersectionObserver(observerCallback, {
      root: scrollRef.current,
      threshold: 0.1,
    })
    observer.observe(sentinel)
    return () => observer.disconnect()
  }, [observerCallback])

  return (
    <div
      ref={scrollRef}
      onScroll={handleScroll}
      className="flex-1 overflow-y-auto"
    >
      {/* Sentinel for loading older messages */}
      {hasMore && (
        <div ref={sentinelRef} className="flex justify-center py-2">
          {isLoadingOlder && (
            <Loader2 size={16} className="animate-spin text-gray-400" />
          )}
        </div>
      )}

      <div className="flex flex-col gap-1 py-2">
        {messages.map((msg, i) => {
          const isOwn = msg.sender.id === currentUserId
          const prevMsg = messages[i - 1]
          const showAvatar =
            !isOwn &&
            (!prevMsg || prevMsg.sender.id !== msg.sender.id)

          return (
            <MessageBubble
              key={msg.id}
              message={msg}
              isOwn={isOwn}
              showAvatar={showAvatar}
            />
          )
        })}
      </div>

      <TypingIndicator names={typingNames} />
    </div>
  )
}
</file>

<file path="src/components/chat/chat-window.tsx">
import { useEffect } from 'react'
import { cn } from '@/lib/utils'
import { useChatStore } from '@/stores/chat.store'
import { useAuthStore } from '@/stores/auth.store'
import { useChatMessages } from '@/hooks/use-chat-messages'
import { ChatWindowHeader } from './chat-window-header'
import { ChatWindowMessages } from './chat-window-messages'
import { ChatWindowInput } from './chat-window-input'

interface ChatWindowProps {
  roomId: number
  index: number
}

export function ChatWindow({ roomId, index }: ChatWindowProps) {
  const { user } = useAuthStore()
  const room = useChatStore((s) => s.rooms.find((r) => r.id === roomId))
  const isMinimized = useChatStore((s) => s.minimizedRoomIds.has(roomId))
  const onlineUserIds = useChatStore((s) => s.onlineUserIds)
  const typingUsers = useChatStore((s) =>
    s.typingUsers.filter(
      (t) => t.roomId === roomId && t.userId !== user?.id
    )
  )
  const { closeWindow, minimizeWindow, restoreWindow } = useChatStore()

  const {
    messages,
    isLoadingOlder,
    hasMore,
    loadInitialMessages,
    loadOlderMessages,
    sendMessage,
    emitTyping,
    currentUserId,
  } = useChatMessages(roomId)

  useEffect(() => {
    loadInitialMessages()
  }, [loadInitialMessages])

  if (!room) return null

  // For private rooms, display the other member's name
  const otherMember = room.members.find((m) => m.id !== user?.id)
  const displayName = room.isGroup
    ? room.name || 'Group Chat'
    : otherMember?.name || 'Chat'
  const displayAvatar = room.isGroup ? undefined : otherMember?.avatar
  const isOnline = otherMember ? onlineUserIds.has(otherMember.id) : false

  // Position: stacked from right. Each window is 328px wide + 12px gap
  // Offset from right edge, after the trigger button area (80px)
  const rightOffset = 80 + index * (328 + 12)

  return (
    <div
      className={cn(
        'fixed bottom-0 z-50 flex w-[328px] flex-col rounded-t-lg bg-white shadow-lg transition-all',
        isMinimized ? 'h-[48px]' : 'h-[455px]'
      )}
      style={{ right: rightOffset }}
    >
      <ChatWindowHeader
        name={displayName}
        avatar={displayAvatar}
        isOnline={isOnline}
        isMinimized={isMinimized}
        onMinimize={() => minimizeWindow(roomId)}
        onClose={() => closeWindow(roomId)}
        onRestore={() => restoreWindow(roomId)}
      />

      {!isMinimized && (
        <>
          <ChatWindowMessages
            messages={messages}
            currentUserId={currentUserId}
            typingNames={typingUsers.map((t) => t.name)}
            isLoadingOlder={isLoadingOlder}
            hasMore={hasMore}
            onLoadOlder={loadOlderMessages}
          />
          <ChatWindowInput onSend={sendMessage} onTyping={emitTyping} />
        </>
      )}
    </div>
  )
}
</file>

<file path="src/components/chat/message-bubble.tsx">
import { cn } from '@/lib/utils'
import type { ChatMessage } from '@/types/chat.types'

interface MessageBubbleProps {
  message: ChatMessage
  isOwn: boolean
  showAvatar?: boolean
}

function formatTime(dateStr: string) {
  const date = new Date(dateStr)
  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
}

export function MessageBubble({ message, isOwn, showAvatar }: MessageBubbleProps) {
  return (
    <div
      className={cn('flex gap-2 px-3', isOwn ? 'justify-end' : 'justify-start')}
    >
      {!isOwn && showAvatar && (
        <div className="flex h-7 w-7 shrink-0 items-center justify-center self-end rounded-full bg-gray-300 text-[10px] font-medium text-gray-700">
          {message.sender.name
            .split(' ')
