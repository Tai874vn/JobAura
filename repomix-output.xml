import { cn } from '@/lib/utils'
import { ChatAvatar } from './chat-avatar'
import type { ChatRoom } from '@/types/chat.types'

interface ChatPanelRoomItemProps {
  room: ChatRoom
  currentUserId: number | undefined
  isOnline: boolean
  onClick: () => void
}

function formatRelativeTime(dateStr: string) {
  const now = Date.now()
  const date = new Date(dateStr).getTime()
  const diff = now - date

  const minutes = Math.floor(diff / 60000)
  if (minutes < 1) return 'now'
  if (minutes < 60) return `${minutes}m`

  const hours = Math.floor(minutes / 60)
  if (hours < 24) return `${hours}h`

  const days = Math.floor(hours / 24)
  if (days < 7) return `${days}d`

  return new Date(dateStr).toLocaleDateString([], {
    month: 'short',
    day: 'numeric',
  })
}

export function ChatPanelRoomItem({
  room,
  currentUserId,
  isOnline,
  onClick,
}: ChatPanelRoomItemProps) {
  const otherMember = room.members.find((m) => m.id !== currentUserId)
  const displayName = room.isGroup
    ? room.name || 'Group Chat'
    : otherMember?.name || 'Chat'
  const displayAvatar = room.isGroup ? undefined : otherMember?.avatar

  const lastMsg = room.lastMessage
  const lastMsgPreview = lastMsg
    ? lastMsg.sender.id === currentUserId
      ? `You: ${lastMsg.content}`
      : lastMsg.content
    : 'No messages yet'

  const timeStr = lastMsg ? formatRelativeTime(lastMsg.createdAt) : ''

  return (
    <button
      onClick={onClick}
      className="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left transition-colors hover:bg-gray-100"
    >
      <ChatAvatar
        name={displayName}
        avatar={displayAvatar}
        isOnline={isOnline}
        size="lg"
      />
      <div className="flex-1 overflow-hidden">
        <div className="flex items-center justify-between">
          <p
            className={cn(
              'truncate text-sm',
              room.unreadCount > 0 ? 'font-bold' : 'font-medium'
            )}
          >
            {displayName}
          </p>
          <span className="ml-2 shrink-0 text-xs text-gray-500">{timeStr}</span>
        </div>
        <div className="flex items-center justify-between">
          <p
            className={cn(
              'truncate text-xs',
              room.unreadCount > 0
                ? 'font-semibold text-gray-900'
                : 'text-gray-500'
            )}
          >
            {lastMsgPreview}
          </p>
          {room.unreadCount > 0 && (
            <span className="ml-2 flex h-5 min-w-5 shrink-0 items-center justify-center rounded-full bg-blue-500 px-1.5 text-[10px] font-bold text-white">
              {room.unreadCount > 99 ? '99+' : room.unreadCount}
            </span>
          )}
        </div>
      </div>
    </button>
  )
}
</file>

