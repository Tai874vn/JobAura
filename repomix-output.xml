import { apiClient, uploadClient } from './client'
import type { User, CreateUser, UpdateUser, ApiResponse, PaginatedResponse, PaginationParams, Job } from '@/schemas'

export interface PublicProfile {
  id: number
  name: string
  avatar?: string
  skill?: string
  certification?: string
  createdAt?: string
  congViecs: Pick<Job, 'id' | 'tenCongViec' | 'hinhAnh' | 'giaTien' | 'saoCongViec' | 'danhGia' | 'moTaNgan'>[]
  _count: {
    congViecs: number
    binhLuans: number
  }
}

export const usersApi = {
  getAll: async (): Promise<ApiResponse<User[]>> => {
    const response = await apiClient.get('/api/users')
    return response.data
  },

  getPaginated: async (params: PaginationParams): Promise<PaginatedResponse<User>> => {
    const response = await apiClient.get('/api/users/phan-trang-tim-kiem', { params })
    return response.data
  },

  getById: async (id: number): Promise<ApiResponse<User>> => {
    const response = await apiClient.get(`/api/users/${id}`)
    return response.data
  },

  search: async (name: string): Promise<ApiResponse<User[]>> => {
    const response = await apiClient.get(`/api/users/search/${name}`)
    return response.data
  },

  create: async (data: CreateUser): Promise<ApiResponse<User>> => {
    const response = await apiClient.post('/api/users', data)
    return response.data
  },

  update: async (id: number, data: UpdateUser): Promise<ApiResponse<User>> => {
    const response = await apiClient.put(`/api/users/${id}`, data)
    return response.data
  },

  delete: async (id: number): Promise<ApiResponse<void>> => {
    const response = await apiClient.delete(`/api/users/${id}`)
    return response.data
  },

  getPublicProfile: async (id: number): Promise<ApiResponse<PublicProfile>> => {
    const response = await apiClient.get(`/api/users/profile/${id}`)
    return response.data
  },

  uploadAvatar: async (file: File): Promise<ApiResponse<User>> => {
    const formData = new FormData()
    formData.append('file', file)
    const response = await uploadClient.post('/api/users/upload-avatar', formData)
    return response.data
  },

  adminUploadAvatar: async (userId: number, file: File): Promise<ApiResponse<User>> => {
    const formData = new FormData()
    formData.append('file', file)
    const response = await uploadClient.post(`/api/users/upload-avatar/${userId}`, formData)
    return response.data
  },
}
