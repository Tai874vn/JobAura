import { useState } from 'react'
import { useQuery, useMutation } from '@tanstack/react-query'
import { Trash2, CheckCircle } from 'lucide-react'
import { toast } from 'sonner'
import { Button, Card, CardContent, Input, Badge, Spinner, Pagination } from '@/components/ui'
import { hiredJobsApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { queryClient } from '@/lib/query-client'
import { getApiErrorMessage } from '@/lib/utils'

export function HiredJobsAdminPage() {
  const [searchKeyword, setSearchKeyword] = useState('')
  const [page, setPage] = useState(1)
  const pageSize = 10

  const { data, isLoading } = useQuery({
    queryKey: [...QUERY_KEYS.hiredJobs, page, pageSize, searchKeyword],
    queryFn: () => hiredJobsApi.getPaginated({ page, pageSize, keyword: searchKeyword || undefined }),
  })

  const deleteMutation = useMutation({
    mutationFn: hiredJobsApi.delete,
    onSuccess: () => {
      toast.success('Hired job deleted successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.hiredJobs })
    },
    onError: (error) => {
      toast.error(getApiErrorMessage(error, 'Failed to delete hired job'))
    },
  })

  const completeMutation = useMutation({
    mutationFn: hiredJobsApi.complete,
    onSuccess: () => {
      toast.success('Job marked as completed')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.hiredJobs })
    },
    onError: (error) => {
      toast.error(getApiErrorMessage(error, 'Failed to mark job as completed'))
    },
  })

  const handleDelete = (id: number) => {
    if (confirm('Are you sure you want to delete this hired job record?')) {
      deleteMutation.mutate(id)
    }
  }

  const handleComplete = (id: number) => {
    if (confirm('Mark this job as completed?')) {
      completeMutation.mutate(id)
    }
