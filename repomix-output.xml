import { Link } from 'react-router-dom'
import { useQuery, useMutation } from '@tanstack/react-query'
import { CheckCircle, Briefcase, Calendar, ExternalLink } from 'lucide-react'
import { toast } from 'sonner'
import { Button, Card, CardContent, Badge, Spinner } from '@/components/ui'
import { hiredJobsApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { queryClient } from '@/lib/query-client'
import { getApiErrorMessage } from '@/lib/utils'

export function MyHiredJobsPage() {
  const { data, isLoading } = useQuery({
    queryKey: [...QUERY_KEYS.hiredJobs, 'my'],
    queryFn: hiredJobsApi.getHiredList,
  })

  const completeMutation = useMutation({
    mutationFn: hiredJobsApi.complete,
    onSuccess: () => {
      toast.success('Job marked as completed!')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.hiredJobs })
    },
    onError: (error) => {
      toast.error(getApiErrorMessage(error, 'Failed to mark job as completed'))
    },
  })

  const handleComplete = (id: number) => {
    if (confirm('Mark this job as completed?')) {
      completeMutation.mutate(id)
    }
  }

  const hiredJobs = data?.content || []

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-slate-950">
      <div className="container mx-auto px-4 py-8">
        <div className="mb-8">
          <h1 className="mb-2 text-3xl font-bold text-gray-900 dark:text-slate-50">My Hired Jobs</h1>
          <p className="text-gray-500 dark:text-slate-400">Jobs you've hired that are still in progress</p>
        </div>

        {isLoading ? (
          <div className="flex justify-center py-12">
            <Spinner size="lg" />
          </div>
        ) : hiredJobs.length === 0 ? (
          <Card>
            <CardContent className="flex flex-col items-center justify-center py-16">
              <Briefcase className="mb-4 h-12 w-12 text-gray-300 dark:text-slate-700" />
              <h3 className="mb-2 text-lg font-semibold text-gray-700 dark:text-slate-300">No active jobs</h3>
              <p className="mb-4 text-gray-500 dark:text-slate-400">You haven't hired any jobs yet.</p>
              <Link to="/jobs">
                <Button>Browse Jobs</Button>
              </Link>
            </CardContent>
          </Card>
        ) : (
          <div className="space-y-4">
            {hiredJobs.map((hiredJob) => (
              <Card key={hiredJob.id}>
                <CardContent className="flex items-center justify-between p-6">
                  <div className="flex items-center gap-4 flex-1">
                    {hiredJob.congViec?.hinhAnh ? (
                      <img
                        src={hiredJob.congViec.hinhAnh}
                        alt={hiredJob.congViec.tenCongViec}
                        className="h-16 w-16 rounded-lg object-cover"
                      />
                    ) : (
                      <div className="flex h-16 w-16 items-center justify-center rounded-lg bg-gray-100 dark:bg-slate-700">
                        <Briefcase className="h-6 w-6 text-gray-400 dark:text-slate-500" />
                      </div>
                    )}
                    <div className="flex-1">
                      <div className="flex items-center gap-3">
                        <h3 className="text-lg font-semibold text-gray-900 dark:text-slate-50">
                          {hiredJob.congViec?.tenCongViec || `Job #${hiredJob.maCongViec}`}
                        </h3>
                        <Badge variant="secondary">In Progress</Badge>
                      </div>
                      <div className="mt-1 flex items-center gap-4 text-sm text-gray-500 dark:text-slate-400">
                        {hiredJob.congViec?.giaTien && (
                          <span className="font-medium text-gray-700 dark:text-slate-300">${hiredJob.congViec.giaTien}</span>
                        )}
                        {hiredJob.ngayThue && (
                          <span className="flex items-center gap-1">
                            <Calendar className="h-3.5 w-3.5" />
                            Hired {new Date(hiredJob.ngayThue).toLocaleDateString()}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <Link to={`/jobs/${hiredJob.maCongViec}`}>
                      <Button variant="outline" size="sm">
                        <ExternalLink className="mr-1 h-4 w-4" />
                        View
                      </Button>
                    </Link>
                    <Button
                      size="sm"
                      onClick={() => handleComplete(hiredJob.id)}
                      disabled={completeMutation.isPending}
                    >
                      <CheckCircle className="mr-1 h-4 w-4" />
                      Complete
                    </Button>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}
