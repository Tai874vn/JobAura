import { useState, useRef } from 'react'
import { Link, useNavigate } from 'react-router-dom'
import { useQuery, useMutation } from '@tanstack/react-query'
import { Pencil, Trash2, Plus, Upload, ImageIcon, Star } from 'lucide-react'
import { toast } from 'sonner'
import { Button, Card, CardContent, Input, Badge, Spinner, Modal, Label, Textarea } from '@/components/ui'
import { jobsApi, jobDetailTypesApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'
import { queryClient } from '@/lib/query-client'
import { getApiErrorMessage } from '@/lib/utils'
import { useAuthStore } from '@/stores'
import type { Job, CreateJob } from '@/schemas'

export function MyPostsPage() {
  const navigate = useNavigate()
  const { user } = useAuthStore()
  const [isModalOpen, setIsModalOpen] = useState(false)
  const [editingJob, setEditingJob] = useState<Job | null>(null)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [previewUrl, setPreviewUrl] = useState<string | null>(null)
  const fileInputRef = useRef<HTMLInputElement>(null)
  const [formData, setFormData] = useState<Partial<CreateJob>>({
    tenCongViec: '',
    giaTien: 0,
    moTaNgan: '',
    moTa: '',
    maChiTietLoai: 0,
  })

  const { data, isLoading } = useQuery({
    queryKey: [...QUERY_KEYS.jobs, 'my-posts'],
    queryFn: jobsApi.getAll,
  })

  const { data: jobDetailTypesData } = useQuery({
    queryKey: QUERY_KEYS.jobDetailTypes,
    queryFn: jobDetailTypesApi.getAll,
  })

  const updateMutation = useMutation({
    mutationFn: async ({ id, data }: { id: number; data: Partial<CreateJob> }) => {
      const result = await jobsApi.update(id, data)
      if (selectedFile) {
        await jobsApi.uploadImage(id, selectedFile)
      }
      return result
    },
    onSuccess: () => {
      toast.success('Job updated successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
      closeModal()
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to update job')),
  })

  const deleteMutation = useMutation({
    mutationFn: jobsApi.delete,
    onSuccess: () => {
      toast.success('Job deleted successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to delete job')),
  })

  const uploadMutation = useMutation({
    mutationFn: ({ id, file }: { id: number; file: File }) => jobsApi.uploadImage(id, file),
    onSuccess: () => {
      toast.success('Image uploaded successfully')
      queryClient.invalidateQueries({ queryKey: QUERY_KEYS.jobs })
    },
    onError: (error) => toast.error(getApiErrorMessage(error, 'Failed to upload image')),
  })

  const handleDelete = (id: number, name: string) => {
    if (confirm(`Are you sure you want to delete "${name}"?`)) {
      deleteMutation.mutate(id)
    }
  }

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return
    setSelectedFile(file)
    setPreviewUrl(URL.createObjectURL(file))
  }

  const handleQuickUpload = (jobId: number, e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return
    uploadMutation.mutate({ id: jobId, file })
  }

  const openEditModal = (job: Job) => {
    setEditingJob(job)
    setSelectedFile(null)
    setPreviewUrl(job.hinhAnh || null)
    setFormData({
      tenCongViec: job.tenCongViec,
      giaTien: job.giaTien,
      moTaNgan: job.moTaNgan || '',
      moTa: job.moTa || '',
      maChiTietLoai: job.maChiTietLoai,
    })
    setIsModalOpen(true)
  }

  const closeModal = () => {
    setIsModalOpen(false)
    setEditingJob(null)
    setSelectedFile(null)
    setPreviewUrl(null)
  }

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()
    if (!formData.tenCongViec || !formData.maChiTietLoai) {
      toast.error('Please fill in required fields')
      return
    }
    if (editingJob) {
      updateMutation.mutate({ id: editingJob.id, data: formData })
    }
  }

  const allJobs = data?.content || []
  const myJobs = allJobs.filter((job) => job.nguoiTao === user?.id)
  const jobDetailTypes = jobDetailTypesData?.content || []

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-slate-950">
      <div className="container mx-auto px-4 py-8">
        <div className="mb-6 flex items-center justify-between">
          <h1 className="text-3xl font-bold text-gray-900 dark:text-slate-50">My Posts</h1>
          <Button onClick={() => navigate('/jobs/new')}>
            <Plus className="mr-2 h-4 w-4" />
            Post a Job
          </Button>
        </div>

        {isLoading ? (
          <div className="flex justify-center py-12">
            <Spinner size="lg" />
          </div>
        ) : myJobs.length === 0 ? (
          <Card>
            <CardContent className="flex flex-col items-center justify-center py-12">
              <p className="text-gray-500 dark:text-slate-400 mb-4">You haven't posted any jobs yet.</p>
              <Button onClick={() => navigate('/jobs/new')}>
                <Plus className="mr-2 h-4 w-4" />
                Post Your First Job
              </Button>
            </CardContent>
          </Card>
        ) : (
          <div className="space-y-4">
            {myJobs.map((job) => (
              <Card key={job.id}>
                <CardContent className="flex items-center justify-between p-6">
                  <Link to={`/jobs/${job.id}`} className="flex items-center gap-4 flex-1 min-w-0">
                    {job.hinhAnh ? (
                      <img src={job.hinhAnh} alt={job.tenCongViec} className="h-14 w-14 rounded-lg object-cover flex-shrink-0" />
                    ) : (
                      <div className="flex h-14 w-14 items-center justify-center rounded-lg bg-gray-100 dark:bg-slate-700 flex-shrink-0">
                        <ImageIcon className="h-6 w-6 text-gray-400 dark:text-slate-500" />
                      </div>
                    )}
                    <div className="min-w-0">
                      <div className="flex items-center gap-3">
                        <h3 className="text-lg font-semibold text-gray-900 dark:text-slate-50 truncate">{job.tenCongViec}</h3>
                        <Badge variant="secondary">${job.giaTien}</Badge>
                      </div>
                      <p className="mt-1 text-sm text-gray-500 dark:text-slate-400 line-clamp-1">{job.moTaNgan}</p>
                      <div className="mt-1 flex items-center gap-1 text-sm text-gray-400 dark:text-slate-500">
                        <Star className="h-3 w-3 fill-yellow-400 text-yellow-400" />
                        <span>{job.saoCongViec || 0}</span>
                        <span>({job.danhGia || 0} reviews)</span>
                      </div>
                    </div>
                  </Link>
                  <div className="flex gap-2 flex-shrink-0 ml-4">
                    <div className="relative">
                      <input
                        type="file"
                        accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
                        onChange={(e) => handleQuickUpload(job.id, e)}
                        className="hidden"
                        id={`upload-${job.id}`}
                      />
                      <Button
                        variant="outline"
                        size="sm"
                        onClick={() => document.getElementById(`upload-${job.id}`)?.click()}
                        disabled={uploadMutation.isPending}
                      >
                        <Upload className="h-4 w-4" />
                      </Button>
                    </div>
                    <Button variant="outline" size="sm" onClick={() => openEditModal(job)}>
                      <Pencil className="h-4 w-4" />
                    </Button>
                    <Button
                      variant="destructive"
                      size="sm"
                      onClick={() => handleDelete(job.id, job.tenCongViec)}
                      disabled={deleteMutation.isPending}
                    >
                      <Trash2 className="h-4 w-4" />
                    </Button>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        )}

        {/* Edit Modal */}
        <Modal isOpen={isModalOpen} onClose={closeModal} title="Edit Job" className="max-w-xl">
          <form onSubmit={handleSubmit} className="space-y-4">
            {/* Image Upload */}
            <div>
              <Label>Image</Label>
              <input
                ref={fileInputRef}
                type="file"
                accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
                onChange={handleFileChange}
                className="hidden"
              />
              <div
                onClick={() => fileInputRef.current?.click()}
                className="mt-1 flex cursor-pointer items-center justify-center rounded-lg border-2 border-dashed border-gray-300 dark:border-slate-700 p-4 transition-colors hover:border-gray-400 dark:hover:border-slate-600"
              >
                {previewUrl ? (
                  <img src={previewUrl} alt="Preview" className="h-32 w-full rounded-md object-cover" />
                ) : (
                  <div className="flex flex-col items-center gap-2 text-gray-400 dark:text-slate-500">
                    <Upload className="h-8 w-8" />
                    <span className="text-sm">Click to upload image</span>
                  </div>
                )}
              </div>
            </div>

            <div>
              <Label htmlFor="tenCongViec">Job Name *</Label>
              <Input
                id="tenCongViec"
                value={formData.tenCongViec}
                onChange={(e) => setFormData({ ...formData, tenCongViec: e.target.value })}
                placeholder="Enter job name"
              />
            </div>

            <div>
              <Label htmlFor="maChiTietLoai">Category *</Label>
              <select
                id="maChiTietLoai"
                value={formData.maChiTietLoai}
                onChange={(e) => setFormData({ ...formData, maChiTietLoai: Number(e.target.value) })}
                className="w-full rounded-md border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-900 dark:text-slate-50 px-3 py-2"
              >
                <option value={0}>Select category</option>
                {jobDetailTypes.map((type) => (
                  <option key={type.id} value={type.id}>{type.tenChiTiet}</option>
                ))}
              </select>
            </div>

            <div>
              <Label htmlFor="giaTien">Price ($)</Label>
              <Input
                id="giaTien"
                type="number"
                value={formData.giaTien}
                onChange={(e) => setFormData({ ...formData, giaTien: Number(e.target.value) })}
              />
            </div>

            <div>
              <Label htmlFor="moTaNgan">Short Description</Label>
              <Input
                id="moTaNgan"
                value={formData.moTaNgan}
                onChange={(e) => setFormData({ ...formData, moTaNgan: e.target.value })}
              />
            </div>

            <div>
              <Label htmlFor="moTa">Full Description</Label>
              <Textarea
                id="moTa"
                value={formData.moTa}
                onChange={(e) => setFormData({ ...formData, moTa: e.target.value })}
                rows={4}
              />
            </div>

            <div className="flex justify-end gap-2 pt-4">
              <Button type="button" variant="outline" onClick={closeModal}>Cancel</Button>
              <Button type="submit" disabled={updateMutation.isPending}>
                {updateMutation.isPending && <Spinner size="sm" className="mr-2" />}
                Update
              </Button>
            </div>
          </form>
        </Modal>
      </div>
    </div>
  )
}
