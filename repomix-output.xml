import { useMemo } from 'react'
import { useQuery } from '@tanstack/react-query'
import { Link } from 'react-router-dom'
import { Briefcase, Users, FolderKanban, MessageSquare, ClipboardList, Layers, Star, DollarSign, CheckCircle, Clock } from 'lucide-react'
import { Card, CardContent, CardHeader, CardTitle, Spinner } from '@/components/ui'
import { jobsApi, usersApi, jobTypesApi, commentsApi, hiredJobsApi, jobDetailTypesApi } from '@/api'
import { QUERY_KEYS } from '@/lib/constants'

export function AdminDashboard() {
  const { data: jobsData, isLoading: loadingJobs } = useQuery({
    queryKey: QUERY_KEYS.jobs,
    queryFn: jobsApi.getAll,
  })

  const { data: usersData, isLoading: loadingUsers } = useQuery({
    queryKey: QUERY_KEYS.users,
    queryFn: usersApi.getAll,
  })

  const { data: jobTypesData, isLoading: loadingTypes } = useQuery({
    queryKey: QUERY_KEYS.jobTypes,
    queryFn: jobTypesApi.getAll,
  })

  const { data: jobDetailTypesData, isLoading: loadingDetailTypes } = useQuery({
    queryKey: QUERY_KEYS.jobDetailTypes,
    queryFn: jobDetailTypesApi.getAll,
  })

  const { data: commentsData, isLoading: loadingComments } = useQuery({
    queryKey: QUERY_KEYS.comments,
    queryFn: commentsApi.getAll,
  })

  const { data: hiredJobsData, isLoading: loadingHired } = useQuery({
    queryKey: QUERY_KEYS.hiredJobs,
    queryFn: hiredJobsApi.getAll,
  })

  const jobs = jobsData?.content || []
  const hiredJobs = hiredJobsData?.content || []
  const comments = commentsData?.content || []

  const derived = useMemo(() => {
    const totalRevenue = jobs.reduce((sum, j) => sum + (j.giaTien || 0), 0)
    const avgRating = jobs.length
      ? (jobs.reduce((sum, j) => sum + (j.saoCongViec || 0), 0) / jobs.length).toFixed(1)
      : '0'
    const completedHired = hiredJobs.filter((h) => h.hoanThanh).length
    const pendingHired = hiredJobs.filter((h) => !h.hoanThanh).length
    const completionRate = hiredJobs.length
      ? Math.round((completedHired / hiredJobs.length) * 100)
      : 0
    const avgCommentRating = comments.length
      ? (comments.reduce((sum, c) => sum + (c.saoBinhLuan || 0), 0) / comments.length).toFixed(1)
      : '0'
    return { totalRevenue, avgRating, completedHired, pendingHired, completionRate, avgCommentRating }
  }, [jobs, hiredJobs, comments])

  const stats = [
    {
      title: 'Total Jobs',
      value: jobs.length,
      loading: loadingJobs,
      icon: Briefcase,
      link: '/admin/jobs',
      color: 'text-blue-600',
      bgColor: 'bg-blue-50',
    },
    {
      title: 'Total Users',
      value: usersData?.content?.length || 0,
      loading: loadingUsers,
      icon: Users,
      link: '/admin/users',
      color: 'text-green-600',
      bgColor: 'bg-green-50',
    },
    {
      title: 'Job Types',
      value: jobTypesData?.content?.length || 0,
      loading: loadingTypes,
      icon: FolderKanban,
      link: '/admin/job-types',
      color: 'text-purple-600',
      bgColor: 'bg-purple-50',
    },
    {
      title: 'Subcategories',
      value: jobDetailTypesData?.content?.length || 0,
      loading: loadingDetailTypes,
      icon: Layers,
      link: '/admin/job-detail-types',
      color: 'text-indigo-600',
      bgColor: 'bg-indigo-50',
    },
    {
      title: 'Hired Jobs',
      value: hiredJobs.length,
      loading: loadingHired,
      icon: ClipboardList,
      link: '/admin/hired-jobs',
      color: 'text-teal-600',
      bgColor: 'bg-teal-50',
    },
    {
      title: 'Comments',
      value: comments.length,
      loading: loadingComments,
      icon: MessageSquare,
      link: '/admin/comments',
      color: 'text-orange-600',
      bgColor: 'bg-orange-50',
    },
  ]

  const isLoadingAll = loadingJobs || loadingHired || loadingComments

  return (
    <div className="p-8">
      <h1 className="mb-8 text-3xl font-bold">Dashboard</h1>

      {/* Stats Grid */}
      <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {stats.map((stat) => (
          <Link key={stat.title} to={stat.link}>
            <Card className="transition-shadow hover:shadow-lg">
              <CardHeader className="flex flex-row items-center justify-between pb-2">
                <CardTitle className="text-sm font-medium text-gray-500">
                  {stat.title}
                </CardTitle>
                <div className={`rounded-full p-2 ${stat.bgColor}`}>
                  <stat.icon className={`h-5 w-5 ${stat.color}`} />
                </div>
              </CardHeader>
              <CardContent>
                {stat.loading ? (
                  <Spinner size="sm" />
                ) : (
                  <div className="text-3xl font-bold">{stat.value}</div>
                )}
              </CardContent>
            </Card>
          </Link>
        ))}
      </div>

      {/* Analytics */}
      <div className="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {/* Revenue & Jobs */}
        <Card>
          <CardHeader>
            <CardTitle>Job Statistics</CardTitle>
          </CardHeader>
          <CardContent>
            {isLoadingAll ? (
              <div className="flex justify-center py-8">
                <Spinner size="lg" />
              </div>
            ) : (
              <div className="space-y-6">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="rounded-full bg-emerald-50 p-2">
                      <DollarSign className="h-5 w-5 text-emerald-600" />
                    </div>
                    <div>
                      <p className="text-sm text-gray-500">Total Listed Value</p>
                      <p className="text-2xl font-bold">${derived.totalRevenue.toLocaleString()}</p>
                    </div>
                  </div>
                </div>

                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="rounded-full bg-yellow-50 p-2">
                      <Star className="h-5 w-5 text-yellow-600" />
                    </div>
                    <div>
                      <p className="text-sm text-gray-500">Average Job Rating</p>
                      <p className="text-2xl font-bold">{derived.avgRating}<span className="text-base font-normal text-gray-400"> / 5</span></p>
                    </div>
                  </div>
                </div>

                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="rounded-full bg-orange-50 p-2">
                      <MessageSquare className="h-5 w-5 text-orange-600" />
                    </div>
                    <div>
                      <p className="text-sm text-gray-500">Average Comment Rating</p>
                      <p className="text-2xl font-bold">{derived.avgCommentRating}<span className="text-base font-normal text-gray-400"> / 5</span></p>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </CardContent>
        </Card>

        {/* Hired Jobs Breakdown */}
        <Card>
          <CardHeader>
            <CardTitle>Hired Jobs Breakdown</CardTitle>
          </CardHeader>
          <CardContent>
            {isLoadingAll ? (
              <div className="flex justify-center py-8">
                <Spinner size="lg" />
              </div>
            ) : (
              <div className="space-y-6">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="rounded-full bg-green-50 p-2">
                      <CheckCircle className="h-5 w-5 text-green-600" />
                    </div>
                    <div>
                      <p className="text-sm text-gray-500">Completed</p>
                      <p className="text-2xl font-bold">{derived.completedHired}</p>
                    </div>
                  </div>
                </div>

                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="rounded-full bg-amber-50 p-2">
                      <Clock className="h-5 w-5 text-amber-600" />
                    </div>
                    <div>
                      <p className="text-sm text-gray-500">In Progress</p>
                      <p className="text-2xl font-bold">{derived.pendingHired}</p>
                    </div>
                  </div>
                </div>

                <div>
                  <div className="mb-2 flex items-center justify-between">
                    <p className="text-sm text-gray-500">Completion Rate</p>
                    <p className="text-sm font-semibold">{derived.completionRate}%</p>
                  </div>
                  <div className="h-3 w-full overflow-hidden rounded-full bg-gray-200">
                    <div
                      className="h-full rounded-full bg-green-500 transition-all"
                      style={{ width: `${derived.completionRate}%` }}
                    />
                  </div>
                </div>
              </div>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  )
}
</file>

