# Local development: the browser calls NestJS directly on port 3002 (no nginx).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
NEXT_PUBLIC_USE_SAME_ORIGIN_API=false
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com
# Server-side Next.js calls and the dev image proxy (/uploads/images) use this address.
BACKEND_API_BASE_URL=http://localhost:3002
